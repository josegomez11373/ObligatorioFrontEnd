@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService Auth
@inject IContextoEmpresa Contexto
@inject NavigationManager Navigation

@if (Auth.CurrentUser is null)
{
    <main class="auth-redirect" aria-live="polite">Redirigiendo al inicio de sesión...</main>
}
else
{
    <div class="siga-shell">
        <aside class="sidebar">
            <a class="brand" href="/" aria-label="SIGA inicio">
                <span class="brand-mark">S</span>
                <span><strong>SIGA</strong><small>Gestión agropecuaria</small></span>
            </a>

            <nav class="main-nav" aria-label="Navegación principal">
                <NavLink href="/" Match="NavLinkMatch.All"><span>▦</span> Resumen</NavLink>
                @if (Auth.CanView(SigaModule.Empresas))
                {
                    <NavLink href="/empresas"><span>◫</span> Empresas</NavLink>
                }
                @if (Auth.CanView(SigaModule.Establecimientos))
                {
                    <NavLink href="/establecimientos"><span>⌂</span> Establecimientos</NavLink>
                    <NavLink href="/potreros"><span>⛳</span> Potreros</NavLink>
                    @if (Auth.CanView(SigaModule.Campanas))
                    {
                        <NavLink href="/campanas"><span>◌</span> Campañas</NavLink>
                    }
                }
                @if (Auth.CanView(SigaModule.Eventos))
                {
                    <NavLink href="/eventos"><span>!</span> Eventos</NavLink>
                }
                @if (Auth.CanView(SigaModule.Historial))
                {
                    <NavLink href="/historial"><span>◷</span> Historial</NavLink>
                }
                @if (Auth.CanView(SigaModule.Tareas))
                {
                    <NavLink href="/tareas"><span>✓</span> Tareas</NavLink>
                }
                @if (Auth.CanView(SigaModule.Catalogos))
                {
                    <NavLink href="/cultivos"><span>♧</span> Cultivos</NavLink>
                    <NavLink href="/catalogos"><span>☷</span> Catálogos</NavLink>
                }
                @if (Auth.CanView(SigaModule.Reportes))
                {
                    <NavLink href="/reportes"><span>▤</span> Reportes</NavLink>
                }
                @if (Auth.CanView(SigaModule.Usuarios))
                {
                    <NavLink href="/usuarios"><span>♙</span> Usuarios</NavLink>
                }
                @if (Auth.CanView(SigaModule.Auditoria))
                {
                    <NavLink href="/auditoria"><span>◉</span> Auditoría</NavLink>
                }
            </nav>

            <div class="sidebar-footer">
                @if (Contexto.PuedeCambiar && Contexto.Disponibles.Count > 1)
                {
                    <div class="company-picker">
                        <label for="empresa-activa">Empresa activa</label>
                        <select id="empresa-activa" @onchange="SeleccionarEmpresa">
                            @foreach (var empresa in Contexto.Disponibles)
                            {
                                <option value="@empresa.Id" selected="@(empresa.Id == Contexto.EmpresaActivaId)">@empresa.Nombre</option>
                            }
                        </select>
                    </div>
                }
                <div class="user-summary">
                    <span class="avatar">@Auth.CurrentUser.Initials</span>
                    <span><strong>@Auth.CurrentUser.Name</strong><small>@Auth.CurrentUser.Role.DisplayName()</small></span>
                </div>
                <button class="sign-out" @onclick="Logout">Cerrar sesión</button>
            </div>
        </aside>

        <main class="page-content">
            @Body
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Auth.StateChanged += HandleAuthenticationChanged;
        Auth.Expirada += HandleExpirada;
        Contexto.Cambiada += HandleContextChanged;

        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private async Task Logout()
    {
        Contexto.Limpiar();
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private async Task SeleccionarEmpresa(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var empresaId))
        {
            await Contexto.SeleccionarAsync(empresaId);
        }
    }

    private void HandleAuthenticationChanged() => InvokeAsync(StateHasChanged);

    private void HandleContextChanged() => InvokeAsync(StateHasChanged);

    private void HandleExpirada() => InvokeAsync(() =>
    {
        Contexto.Limpiar();
        Navigation.NavigateTo("/login", replace: true);
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.StateChanged -= HandleAuthenticationChanged;
        Auth.Expirada -= HandleExpirada;
        Contexto.Cambiada -= HandleContextChanged;
    }
}
