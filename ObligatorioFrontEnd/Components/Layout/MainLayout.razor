@inherits LayoutComponentBase
@implements IDisposable
@implements IAsyncDisposable
@inject IAuthService Auth
@inject IContextoEmpresa Contexto
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (Auth.CurrentUser is null)
{
    <main class="auth-redirect" aria-live="polite">Redirigiendo al inicio de sesión...</main>
}
else
{
    <div class="siga-shell">
        <div class="nav-backdrop @(menuAbierto ? "is-open" : null)" @onclick="CerrarMenu" aria-hidden="true"></div>

        <aside class="sidebar @(menuAbierto ? "is-open" : null)"
               @ref="panelNav"
               tabindex="-1"
               aria-label="Navegación"
               @onkeydown="HandleNavKeyDown">
            <div class="sidebar__bar">
                <a class="brand" href="/" aria-label="SIGA inicio">
                    <span class="brand-mark">S</span>
                    <span><strong>SIGA</strong><small>Gestión agropecuaria</small></span>
                </a>
                <button class="icon-button nav-close" type="button" aria-label="Cerrar menú" @onclick="CerrarMenu">✕</button>
            </div>

            <nav class="main-nav" aria-label="Navegación principal" @onclick="CerrarMenu">
                <NavLink href="/" Match="NavLinkMatch.All"><span>▦</span> Resumen</NavLink>
                @if (Auth.CanView(SigaModule.Empresas))
                {
                    <NavLink href="/empresas"><span>◫</span> Empresas</NavLink>
                }
                @if (Auth.CanView(SigaModule.Establecimientos))
                {
                    <NavLink href="/establecimientos"><span>⌂</span> Establecimientos</NavLink>
                    <NavLink href="/potreros"><span>⬚</span> Potreros</NavLink>
                    <NavLink href="/mapa"><span>⌖</span> Mapa</NavLink>
                    @if (Auth.CanView(SigaModule.Campanas))
                    {
                        <NavLink href="/campanas"><span>◌</span> Campañas</NavLink>
                    }
                }
                @if (Auth.CanView(SigaModule.Eventos))
                {
                    <NavLink href="/eventos"><span>!</span> Eventos</NavLink>
                }
                @if (Auth.CanView(SigaModule.Historial))
                {
                    <NavLink href="/historial"><span>◷</span> Historial</NavLink>
                }
                @if (Auth.CanView(SigaModule.Tareas))
                {
                    <NavLink href="/tareas"><span>✓</span> Tareas</NavLink>
                }
                @if (Auth.CanView(SigaModule.Catalogos))
                {
                    <NavLink href="/cultivos"><span>♧</span> Cultivos</NavLink>
                    <NavLink href="/catalogos"><span>☷</span> Catálogos</NavLink>
                }
                @if (Auth.CanView(SigaModule.Reportes))
                {
                    <NavLink href="/reportes"><span>▤</span> Reportes</NavLink>
                }
                @if (Auth.CanView(SigaModule.Usuarios))
                {
                    <NavLink href="/usuarios"><span>♙</span> Usuarios</NavLink>
                }
                @if (Auth.CanView(SigaModule.Auditoria))
                {
                    <NavLink href="/auditoria"><span>◉</span> Auditoría</NavLink>
                }
            </nav>

            <div class="sidebar-footer">
                @if (Contexto.PuedeCambiar && Contexto.Disponibles.Count > 1)
                {
                    <div class="company-picker">
                        <label for="empresa-activa">Empresa activa</label>
                        <select id="empresa-activa" @onchange="SeleccionarEmpresa">
                            @foreach (var empresa in Contexto.Disponibles)
                            {
                                <option value="@empresa.Id" selected="@(empresa.Id == Contexto.EmpresaActivaId)">@empresa.Nombre</option>
                            }
                        </select>
                    </div>
                }
                <div class="user-summary">
                    <span class="avatar">@Auth.CurrentUser.Initials</span>
                    <span><strong>@Auth.CurrentUser.Name</strong><small>@Auth.CurrentUser.Role.DisplayName()</small></span>
                </div>
                <button class="sign-out" @onclick="Logout">Cerrar sesión</button>
            </div>
        </aside>

        <header class="mobile-topbar">
            <button class="nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="@AriaBool(menuAbierto)" @ref="botonMenu" @onclick="AbrirMenu">
                <span aria-hidden="true">☰</span>
            </button>
            <a class="brand brand--compact" href="/" aria-label="SIGA inicio" @onclick="CerrarMenu">
                <span class="brand-mark brand-mark--compact">S</span>
                <span><strong>SIGA</strong></span>
            </a>
            <span class="mobile-topbar__user" title="@Auth.CurrentUser?.Name @Auth.CurrentUser?.Role.DisplayName()">@Auth.CurrentUser?.Initials</span>
        </header>

        <main class="page-content" style="--section-index: '@IndiceSeccion'">
            @Body
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Auth.StateChanged += HandleAuthenticationChanged;
        Auth.Expirada += HandleExpirada;
        Contexto.Cambiada += HandleContextChanged;
        Navigation.LocationChanged += HandleLocationChanged;

        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private bool menuAbierto;
    private bool enfocarMenu;
    private bool scrollBloqueado;
    private ElementReference panelNav;
    private ElementReference botonMenu;
    private IJSObjectReference? moduloUi;

    private void AbrirMenu()
    {
        menuAbierto = true;
        enfocarMenu = true;
    }

    private void CerrarMenu() => menuAbierto = false;

    /// <summary>
    /// Escape cierra el menú y devuelve el foco al botón ☰, igual que el panel
    /// lateral. Sin esto el menú móvil solo se cerraba con el mouse.
    /// </summary>
    private async Task HandleNavKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return;
        }

        CerrarMenu();
        StateHasChanged();

        try
        {
            await botonMenu.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // El circuito se desconectó; el menú se cerrará con la navegación.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (menuAbierto && enfocarMenu)
        {
            enfocarMenu = false;

            try
            {
                await panelNav.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // El circuito se desconectó; no hay nada que enfocar.
            }
        }

        if (menuAbierto == scrollBloqueado)
        {
            return;
        }

        scrollBloqueado = menuAbierto;

        try
        {
            moduloUi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
            await moduloUi.InvokeVoidAsync("bloquearScroll", menuAbierto);
        }
        catch (JSDisconnectedException)
        {
            // El circuito se desconectó; el bloqueo de scroll ya no importa.
        }
    }

    private static string AriaBool(bool valor) => valor ? "true" : "false";

    /// <summary>
    /// Folio editorial de la sección. Se expone como variable CSS en
    /// <see cref="MainLayout"/> para que el encabezado lo muestre sin que
    /// cada página tenga que declararlo.
    /// </summary>
    private string IndiceSeccion => Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('?', '#')[0]
        .Trim('/')
        .ToLowerInvariant() switch
    {
        "" => "01",
        "empresas" => "02",
        "establecimientos" => "03",
        "potreros" => "04",
        "mapa" => "05",
        "campanas" => "06",
        "eventos" => "07",
        "historial" => "08",
        "tareas" => "09",
        "cultivos" => "10",
        "catalogos" => "11",
        "tipos-evento" => "12",
        "tipos-tarea" => "13",
        "insumos" => "14",
        "maquinaria" => "15",
        "contratistas" => "16",
        "reportes" => "17",
        "usuarios" => "18",
        "auditoria" => "19",
        _ => "—"
    };

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        InvokeAsync(() =>
        {
            menuAbierto = false;
            StateHasChanged();
        });

    private async Task Logout()
    {
        Contexto.Limpiar();
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private async Task SeleccionarEmpresa(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var empresaId))
        {
            await Contexto.SeleccionarAsync(empresaId);
        }
    }

    private void HandleAuthenticationChanged() => InvokeAsync(StateHasChanged);

    private void HandleContextChanged() => InvokeAsync(StateHasChanged);

    private void HandleExpirada() => InvokeAsync(() =>
    {
        Contexto.Limpiar();
        Navigation.NavigateTo("/login", replace: true);
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.StateChanged -= HandleAuthenticationChanged;
        Auth.Expirada -= HandleExpirada;
        Contexto.Cambiada -= HandleContextChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();

        if (moduloUi is not null)
        {
            try
            {
                await moduloUi.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró; el módulo lo libera el navegador.
            }
        }
    }
}
