@page "/establecimientos"
@page "/establecimientos/{editId:guid}"
@implements IDisposable
@inject IServicioEstablecimientos EstablecimientoService
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject NavigationManager Navigation
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Establecimientos | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Establecimientos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Estructura agrícola</p>
            <h1>Establecimientos</h1>
            <p class="page-intro">Crear, editar y desactivar establecimientos pertenecientes a la empresa activa.</p>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewEstablecimiento">Nuevo establecimiento</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <h2>Establecimientos (@(establecimientos?.Count ?? 0))</h2>
        @if (cargando && establecimientos is null)
        {
            <p>Cargando...</p>
        }
        else if (establecimientos is null || !establecimientos.Any())
        {
            <p class="muted">No hay establecimientos registrados para la empresa activa.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Empresa</th><th>Nombre</th><th>Superficie (ha)</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var establecimiento in establecimientos)
                    {
                        <tr class="@(establecimiento.Activo ? null : "row-muted")">
                            <td>@establecimiento.EmpresaNombre</td>
                            <td>@establecimiento.Nombre</td>
                            <td>@(establecimiento.SuperficieHa?.ToString("G") ?? "—")</td>
                            <td>@(establecimiento.Activo ? "Activo" : "Desactivado")</td>
                            <td class="actions">
                                @if (CanManage)
                                {
                                    <button type="button" @onclick="() => EditEstablecimiento(establecimiento.Id)">Editar</button>
                                    @if (establecimiento.Activo)
                                    {
                                        <button type="button" class="destructive" @onclick="() => Deactivate(establecimiento.Id)">Desactivar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Crear establecimiento" : "Editar establecimiento")" OnClose="Cancel">
            <EstablecimientoForm Model="editModel" Empresas="EmpresasForm" OnValidSubmit="HandleFormSubmit" OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<EstablecimientoDto>? establecimientos;
    private EstablecimientoEditModel editModel = new();
    private string? formError;
    private string? error;
    private bool formOpen;
    private bool cargando;
    private Guid? loadedEditId;

    [Parameter]
    public Guid? editId { get; set; }

    private bool CanManage => Auth.CanManage(SigaModule.Establecimientos);

    private IReadOnlyList<EmpresaDto> EmpresasForm =>
        Contexto.EmpresaActiva is { } empresa ? [empresa] : [];

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadEditAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            var lista = await EstablecimientoService.GetAllAsync(incluirInactivos: true);
            var activa = Contexto.EmpresaActivaId;
            establecimientos = activa is Guid empresaId
                ? lista.Where(establecimiento => establecimiento.EmpresaId == empresaId).ToList()
                : lista;
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LoadEditAsync()
    {
        if (editId is not Guid id)
        {
            // Al abrir un alta navegamos a la ruta base; conservamos el formulario.
            if (formOpen && editModel.Id == Guid.Empty)
            {
                return;
            }

            loadedEditId = null;
            formOpen = false;
            return;
        }

        if (loadedEditId == id && formOpen)
        {
            return;
        }

        loadedEditId = id;
        formOpen = true;
        formError = null;

        try
        {
            var establecimiento = await EstablecimientoService.GetByIdAsync(id);
            if (establecimiento is null)
            {
                editModel = NewModel();
                formError = "No se encontró el establecimiento solicitado.";
                return;
            }

            editModel = new EstablecimientoEditModel
            {
                Id = establecimiento.Id,
                EmpresaId = establecimiento.EmpresaId,
                Nombre = establecimiento.Nombre,
                SuperficieHa = establecimiento.SuperficieHa,
                Ubicacion = establecimiento.Ubicacion,
                Responsables = establecimiento.Responsables,
                Activo = establecimiento.Activo,
                Version = establecimiento.Version
            };
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Establecimientos && modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            await LoadEditAsync();
            StateHasChanged();
        });
    }

    private void NewEstablecimiento()
    {
        editModel = NewModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/establecimientos", replace: true);
    }

    private void EditEstablecimiento(Guid id) => Navigation.NavigateTo($"/establecimientos/{id}");

    private void Cancel()
    {
        formOpen = false;
        editModel = NewModel();
        formError = null;
        error = null;
        Navigation.NavigateTo("/establecimientos", replace: true);
    }

    private async Task HandleFormSubmit(EstablecimientoEditModel model)
    {
        formError = null;
        error = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                await EstablecimientoService.CreateAsync(new CrearEstablecimientoDto
                {
                    EmpresaId = model.EmpresaId == Guid.Empty ? null : model.EmpresaId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Ubicacion = model.Ubicacion?.Trim(),
                    Responsables = model.Responsables?.Trim()
                });
            }
            else
            {
                var actualizado = await EstablecimientoService.UpdateAsync(new ActualizarEstablecimientoDto
                {
                    Id = model.Id,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Ubicacion = model.Ubicacion?.Trim(),
                    Responsables = model.Responsables?.Trim(),
                    Activo = model.Activo,
                    Version = model.Version
                });

                if (actualizado is null)
                {
                    formError = "No se encontró el establecimiento.";
                    return;
                }
            }

            Cancel();
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private async Task Deactivate(Guid id)
    {
        error = null;

        try
        {
            await EstablecimientoService.DeactivateAsync(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private EstablecimientoEditModel NewModel() => new()
    {
        EmpresaId = Contexto.EmpresaActivaId ?? Auth.CurrentUser?.EmpresaId ?? Guid.Empty
    };

    public void Dispose() => Notificador.Cambio -= HandleChanged;
}
