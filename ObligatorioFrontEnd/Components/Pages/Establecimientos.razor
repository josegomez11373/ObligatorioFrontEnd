@page "/establecimientos"
@page "/establecimientos/{editId:guid}"
@implements IDisposable
@inject EstablecimientoService EstablecimientoService
@inject EmpresaService EmpresaService
@inject NavigationManager Navigation
@inject DemoAuthService Auth

@using ObligatorioFrontEnd.Models

<PageTitle>Establecimientos | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Establecimientos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Estructura agrícola</p>
            <h1>Establecimientos</h1>
            <p class="page-intro">Crear, editar y desactivar establecimientos pertenecientes a una empresa.</p>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewEstablecimiento">Nuevo establecimiento</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
            <h2>Establecimientos (@(establecimientos?.Count ?? 0))</h2>
            @if (establecimientos is null)
            {
                <p>Cargando...</p>
            }
            else if (!establecimientos.Any())
            {
                <p class="muted">No hay establecimientos registrados.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Empresa</th><th>Nombre</th><th>Superficie (ha)</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var establecimiento in establecimientos)
                        {
                            <tr class="@(establecimiento.Activo ? null : "row-muted")">
                                <td>@(EmpresaService.GetById(establecimiento.EmpresaId)?.Nombre ?? "—")</td>
                                <td>@establecimiento.Nombre</td>
                                <td>@(establecimiento.SuperficieHa?.ToString("G") ?? "—")</td>
                                <td>@(establecimiento.Activo ? "Activo" : "Desactivado")</td>
                                <td class="actions">
                                    @if (CanManage)
                                    {
                                        <button type="button" @onclick="() => EditEstablecimiento(establecimiento.Id)">Editar</button>
                                        @if (establecimiento.Activo)
                                        {
                                            <button type="button" class="destructive" @onclick="() => Deactivate(establecimiento.Id)">Desactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Crear establecimiento" : "Editar establecimiento")" OnClose="Cancel">
            <EstablecimientoForm Model="editModel" OnValidSubmit="HandleFormSubmit" OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<Establecimiento>? establecimientos;
    private EstablecimientoEditModel editModel = new();
    private string? formError;
    private string? error;
    private bool formOpen;

    [Parameter]
    public Guid? editId { get; set; }

    private bool CanManage => Auth.CanManage(SigaModule.Establecimientos);

    protected override void OnInitialized()
    {
        EstablecimientoService.StateChanged += HandleChanged;
        Load();
    }

    protected override void OnParametersSet()
    {
        formOpen = editId is not null;
        if (editId is not null)
        {
            var establecimiento = EstablecimientoService.GetById(editId.Value);
            if (establecimiento is not null)
            {
                editModel = new EstablecimientoEditModel
                {
                    Id = establecimiento.Id,
                    EmpresaId = establecimiento.EmpresaId,
                    Nombre = establecimiento.Nombre,
                    SuperficieHa = establecimiento.SuperficieHa,
                    Ubicacion = establecimiento.Ubicacion,
                    Responsables = establecimiento.Responsables,
                    Activo = establecimiento.Activo,
                    Version = establecimiento.Version
                };
            }
            else
            {
                formError = "No se encontró el establecimiento solicitado.";
            }
        }
        else
        {
            editModel = NewModel();
            formError = null;
        }
    }

    private void Load()
    {
        establecimientos = EstablecimientoService.GetAll();
        InvokeAsync(StateHasChanged);
    }

    private void HandleChanged() => Load();

    private void NewEstablecimiento()
    {
        editModel = NewModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/establecimientos", replace: true);
    }

    private void EditEstablecimiento(Guid id) => Navigation.NavigateTo($"/establecimientos/{id}");

    private void Cancel()
    {
        formOpen = false;
        editModel = NewModel();
        formError = null;
        error = null;
        Navigation.NavigateTo("/establecimientos", replace: true);
    }

    private void HandleFormSubmit(EstablecimientoEditModel model)
    {
        formError = null;
        error = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                EstablecimientoService.Create(new Establecimiento
                {
                    EmpresaId = model.EmpresaId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Ubicacion = model.Ubicacion?.Trim(),
                    Responsables = model.Responsables?.Trim(),
                    Activo = model.Activo
                });
            }
            else
            {
                var updated = new Establecimiento
                {
                    Id = model.Id,
                    EmpresaId = model.EmpresaId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Ubicacion = model.Ubicacion?.Trim(),
                    Responsables = model.Responsables?.Trim(),
                    Activo = model.Activo
                };

                if (!EstablecimientoService.Update(updated, model.Version))
                {
                    formError = "No se encontró el establecimiento.";
                    return;
                }
            }

            editModel = NewModel();
            formOpen = false;
            Navigation.NavigateTo("/establecimientos", replace: true);
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void Deactivate(Guid id)
    {
        error = null;

        try
        {
            EstablecimientoService.Deactivate(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private EstablecimientoEditModel NewModel() => new()
    {
        EmpresaId = Auth.CurrentUser?.EmpresaId ?? Guid.Empty
    };

    public void Dispose() => EstablecimientoService.StateChanged -= HandleChanged;
}
