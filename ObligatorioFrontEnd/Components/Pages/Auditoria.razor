@page "/auditoria"
@implements IDisposable
@inject IServicioAuditoria AuditService
@inject IServicioEmpresas EmpresaService
@inject NotificadorDatos Notificador

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Auditoría | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Auditoria">
    <section class="page-header">
        <div>
            <p class="eyebrow">Control y trazabilidad</p>
            <h1>Auditoría</h1>
            <p class="page-intro">Registro de cambios realizados dentro del alcance actual. Las fechas se muestran en hora de Uruguay.</p>
        </div>
    </section>

    <section class="card report-filters">
        <div class="card-header">
            <div>
                <p class="eyebrow">Búsqueda</p>
                <h2>Filtrar registros</h2>
            </div>
        </div>
        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="aud-entidad">Entidad</label>
                <select id="aud-entidad" @bind="entidadFiltro">
                    <option value="">Todas</option>
                    @foreach (var entidad in entidades)
                    {
                        <option value="@entidad">@entidad</option>
                    }
                </select>
            </div>
            <div class="form-field compact-field">
                <label for="aud-actor">Actor</label>
                <select id="aud-actor" @bind="actorFiltro">
                    <option value="">Todos</option>
                    @foreach (var actor in actores)
                    {
                        <option value="@actor">@actor</option>
                    }
                </select>
            </div>
            <div class="form-field compact-field">
                <label for="aud-empresa">Empresa</label>
                <select id="aud-empresa" @bind="empresaFiltro">
                    <option value="">Todas</option>
                    @foreach (var empresa in empresas)
                    {
                        <option value="@empresa.Id">@empresa.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="aud-desde">Desde</label>
                <InputDate id="aud-desde" @bind-Value="desde" />
            </div>
            <div class="form-field compact-field">
                <label for="aud-hasta">Hasta</label>
                <InputDate id="aud-hasta" @bind-Value="hasta" />
            </div>
            <div class="form-field compact-field filter-actions">
                <label aria-hidden="true">&nbsp;</label>
                <div class="form-actions">
                    <button class="primary-button primary-button--inline" type="button" @onclick="Buscar">Aplicar filtros</button>
                    <button type="button" @onclick="Limpiar">Limpiar</button>
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <div class="card-header">
            <h2>Registros (@total)</h2>
            <span class="muted">Actualizado: @SigaTime.Format(SigaTime.UtcNow)</span>
        </div>

        @if (cargando && entries.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!entries.Any())
        {
            <p class="muted">No hay registros que coincidan con los filtros.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Fecha</th><th>Actor</th><th>Entidad</th><th>Acción</th><th>Empresa</th><th>Detalle</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr>
                            <td>@SigaTime.Format(entry.FechaHoraUtc)</td>
                            <td>@(entry.Actor ?? "—")</td>
                            <td>@entry.Entidad</td>
                            <td>@entry.Accion</td>
                            <td>@EmpresaTexto(entry)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(entry.DatosAnteriores) ||
                                     !string.IsNullOrWhiteSpace(entry.DatosNuevos))
                                {
                                    <details>
                                        <summary>Ver</summary>
                                        <pre class="audit-detail">@Detalle(entry)</pre>
                                    </details>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="form-actions pagination">
                <button type="button" disabled="@(pagina <= 1 || cargando)" @onclick="() => IrPaginaAsync(pagina - 1)">
                    Anterior
                </button>
                <span class="muted">
                    Mostrando @entries.Count de @total · Página @pagina de @TotalPaginas
                </span>
                <button type="button" disabled="@(pagina >= TotalPaginas || cargando)" @onclick="() => IrPaginaAsync(pagina + 1)">
                    Siguiente
                </button>
            </div>
        }
    </section>
</RoleGuard>

@code {
    private const int TamanoPagina = 50;

    private IReadOnlyList<AuditoriaDto> entries = [];
    private IReadOnlyList<string> entidades = [];
    private IReadOnlyList<string> actores = [];
    private IReadOnlyList<EmpresaDto> empresas = [];
    private string entidadFiltro = string.Empty;
    private string actorFiltro = string.Empty;
    private string empresaFiltro = string.Empty;
    private DateTime? desde;
    private DateTime? hasta;
    private string? error;
    private bool cargando;
    private int pagina = 1;
    private int total;

    private int TotalPaginas => total <= 0
        ? 1
        : (int)Math.Ceiling(total / (double)TamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await CargarTodoAsync();
    }

    private async Task CargarTodoAsync()
    {
        cargando = true;
        error = null;

        try
        {
            empresas = await EmpresaService.GetAllAsync(includeInactive: true);
            entidades = await AuditService.GetEntidadesAsync();
            actores = await AuditService.GetActoresAsync();
            await CargarPaginaAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<AuditoriaPaginadaDto> BuscarPaginaAsync() =>
        await AuditService.BuscarAsync(
            string.IsNullOrWhiteSpace(entidadFiltro) ? null : entidadFiltro,
            string.IsNullOrWhiteSpace(actorFiltro) ? null : actorFiltro,
            desde,
            hasta,
            Guid.TryParse(empresaFiltro, out var empresaId) ? empresaId : null,
            pagina,
            TamanoPagina);

    private async Task CargarPaginaAsync()
    {
        var respuesta = await BuscarPaginaAsync();
        entries = respuesta.Items;
        total = respuesta.Total;
    }

    private async Task Buscar()
    {
        cargando = true;
        error = null;

        try
        {
            pagina = 1;
            await CargarPaginaAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task IrPaginaAsync(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > TotalPaginas)
        {
            return;
        }

        cargando = true;
        error = null;

        try
        {
            pagina = nuevaPagina;
            await CargarPaginaAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Auditoria && modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await CargarTodoAsync();
            StateHasChanged();
        });
    }

    private async Task Limpiar()
    {
        entidadFiltro = string.Empty;
        actorFiltro = string.Empty;
        empresaFiltro = string.Empty;
        desde = null;
        hasta = null;
        await Buscar();
    }

    private string EmpresaTexto(AuditoriaDto entry) =>
        entry.EmpresaId is Guid empresaId
            ? empresas.FirstOrDefault(empresa => empresa.Id == empresaId)?.Nombre ?? "—"
            : "—";

    private static string Detalle(AuditoriaDto entry)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(entry.DatosAnteriores))
        {
            parts.Add($"Antes: {entry.DatosAnteriores}");
        }

        if (!string.IsNullOrWhiteSpace(entry.DatosNuevos))
        {
            parts.Add($"Después: {entry.DatosNuevos}");
        }

        return string.Join(Environment.NewLine, parts);
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;
}
