@page "/auditoria"
@implements IAsyncDisposable
@inject IServicioAuditoria AuditService
@inject IServicioEmpresas EmpresaService
@inject NotificadorDatos Notificador
@inject IJSRuntime JS

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Auditoría | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Auditoria">
    <section class="page-header">
        <div>
            <p class="eyebrow">Control y trazabilidad</p>
            <h1>Auditoría</h1>
            <p class="page-intro">Registro de cambios realizados dentro del alcance actual. Las fechas se muestran en hora de Uruguay.</p>
        </div>
    </section>

    <section class="card report-filters">
        <div class="card-header">
            <div>
                <p class="eyebrow">Búsqueda</p>
                <h2>Filtrar registros</h2>
            </div>
        </div>
        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="aud-entidad">Entidad</label>
                <select id="aud-entidad" @bind="entidadFiltro">
                    <option value="">Todas</option>
                    @foreach (var entidad in entidades)
                    {
                        <option value="@entidad">@entidad</option>
                    }
                </select>
            </div>
            <div class="form-field compact-field">
                <label for="aud-actor">Actor</label>
                <select id="aud-actor" @bind="actorFiltro">
                    <option value="">Todos</option>
                    @foreach (var actor in actores)
                    {
                        <option value="@actor">@actor</option>
                    }
                </select>
            </div>
            <div class="form-field compact-field">
                <label for="aud-empresa">Empresa</label>
                <select id="aud-empresa" @bind="empresaFiltro">
                    <option value="">Todas</option>
                    @foreach (var empresa in empresas)
                    {
                        <option value="@empresa.Id">@empresa.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="aud-desde">Desde</label>
                <InputDate id="aud-desde" @bind-Value="desde" />
            </div>
            <div class="form-field compact-field">
                <label for="aud-hasta">Hasta</label>
                <InputDate id="aud-hasta" @bind-Value="hasta" />
            </div>
            <div class="form-field compact-field filter-actions">
                <label aria-hidden="true">&nbsp;</label>
                <div class="form-actions">
                    <button class="primary-button primary-button--inline" type="button" @onclick="Buscar">Aplicar filtros</button>
                    <button type="button" @onclick="Limpiar">Limpiar</button>
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card audit-results" id="auditoria-registros">
        <div class="card-header">
            <h2>Registros (@total)</h2>
            <span class="muted">Actualizado: @SigaTime.Format(SigaTime.UtcNow)</span>
        </div>

        @if (cargando && entries.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!entries.Any())
        {
            <p class="muted">No hay registros que coincidan con los filtros.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table audit-table">
                    <colgroup>
                        <col style="width:14%" />
                        <col style="width:19%" />
                        <col style="width:17%" />
                        <col style="width:10%" />
                        <col style="width:14%" />
                        <col style="width:26%" />
                    </colgroup>
                    <thead>
                        <tr><th>Fecha</th><th>Actor</th><th>Entidad</th><th>Acción</th><th>Empresa</th><th>Detalle</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <tr>
                                <td>@SigaTime.Format(entry.FechaHoraUtc)</td>
                                <td>@(entry.Actor ?? "—")</td>
                                <td>@entry.Entidad</td>
                                <td>@entry.Accion</td>
                                <td>@EmpresaTexto(entry)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(entry.DatosAnteriores) ||
                                         !string.IsNullOrWhiteSpace(entry.DatosNuevos))
                                    {
                                        <button type="button" class="audit-view-button" @onclick="() => AbrirDetalle(entry)">Ver cambios</button>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-actions pagination">
                <button type="button" disabled="@(pagina <= 1 || cargando)" @onclick="() => IrPaginaAsync(pagina - 1)">
                    Anterior
                </button>
                <span class="muted">
                    Mostrando @entries.Count de @total · Página @pagina de @TotalPaginas
                </span>
                <button type="button" disabled="@(pagina >= TotalPaginas || cargando)" @onclick="() => IrPaginaAsync(pagina + 1)">
                    Siguiente
                </button>
            </div>
        }
    </section>

    @if (detalleSeleccionado is { } detalle)
    {
        var cambios = Cambios(detalle);
        <div class="audit-modal-backdrop" @onclick="CerrarDetalle">
            <section class="audit-modal" role="dialog" aria-modal="true" aria-labelledby="audit-modal-title" @onclick:stopPropagation="true">
                <header class="audit-modal__header">
                    <div>
                        <p class="eyebrow">@detalle.Entidad · @detalle.Accion</p>
                        <h2 id="audit-modal-title">Detalle del cambio</h2>
                        <p class="muted">@SigaTime.Format(detalle.FechaHoraUtc) · @(detalle.Actor ?? "Usuario no identificado")</p>
                    </div>
                    <button type="button" class="icon-button" @onclick="CerrarDetalle" aria-label="Cerrar detalle">×</button>
                </header>
                @if (cambios.Count > 0)
                {
                    <div class="audit-changes-wrap audit-changes-wrap--modal">
                        <table class="audit-changes">
                            <thead><tr><th>Campo</th><th>Antes</th><th>Después</th></tr></thead>
                            <tbody>
                                @foreach (var cambio in cambios)
                                {
                                    <tr><td>@cambio.Campo</td><td>@(cambio.Anterior ?? "—")</td><td>@(cambio.Nuevo ?? "—")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="muted audit-no-changes">No hay cambios de negocio para mostrar.</p>
                }
                <footer class="audit-modal__footer"><button type="button" class="primary-button primary-button--inline" @onclick="CerrarDetalle">Cerrar</button></footer>
            </section>
        </div>
    }
</RoleGuard>

@code {
    private const int TamanoPagina = 50;

    private IReadOnlyList<AuditoriaDto> entries = [];
    private IReadOnlyList<string> entidades = [];
    private IReadOnlyList<string> actores = [];
    private IReadOnlyList<EmpresaDto> empresas = [];
    private string entidadFiltro = string.Empty;
    private string actorFiltro = string.Empty;
    private string empresaFiltro = string.Empty;
    private DateTime? desde;
    private DateTime? hasta;
    private string? error;
    private bool cargando;
    private int pagina = 1;
    private int total;
    private IJSObjectReference? moduloUi;
    private AuditoriaDto? detalleSeleccionado;

    private int TotalPaginas => total <= 0
        ? 1
        : (int)Math.Ceiling(total / (double)TamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await CargarTodoAsync();
    }

    private async Task CargarTodoAsync()
    {
        cargando = true;
        error = null;

        try
        {
            empresas = await EmpresaService.GetAllAsync(includeInactive: true);
            var todo = await AuditService.BuscarTodoAsync();

            entidades = todo
                .Select(registro => registro.Entidad)
                .Where(entidad => !string.IsNullOrWhiteSpace(entidad))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(entidad => entidad)
                .ToList();

            actores = todo
                .Select(registro => registro.Actor)
                .Where(actor => !string.IsNullOrWhiteSpace(actor))
                .Select(actor => actor!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(actor => actor)
                .ToList();

            await CargarPaginaAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<AuditoriaPaginadaDto> BuscarPaginaAsync() =>
        await AuditService.BuscarAsync(
            string.IsNullOrWhiteSpace(entidadFiltro) ? null : entidadFiltro,
            string.IsNullOrWhiteSpace(actorFiltro) ? null : actorFiltro,
            desde,
            hasta,
            Guid.TryParse(empresaFiltro, out var empresaId) ? empresaId : null,
            pagina,
            TamanoPagina);

    private async Task CargarPaginaAsync()
    {
        var respuesta = await BuscarPaginaAsync();
        entries = respuesta.Items;
        total = respuesta.Total;
    }

    private async Task Buscar()
    {
        cargando = true;
        error = null;

        try
        {
            pagina = 1;
            await CargarPaginaAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task IrPaginaAsync(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > TotalPaginas)
        {
            return;
        }

        cargando = true;
        error = null;

        try
        {
            pagina = nuevaPagina;
            await CargarPaginaAsync();

            // Al cambiar de página, la lista puede encogerse y dejar la vista a
            // mitad de la tabla. Volvemos al encabezado de los registros.
            await DesplazarARegistrosAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Auditoria && modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await CargarTodoAsync();
            StateHasChanged();
        });
    }

    private async Task Limpiar()
    {
        entidadFiltro = string.Empty;
        actorFiltro = string.Empty;
        empresaFiltro = string.Empty;
        desde = null;
        hasta = null;
        await Buscar();
    }

    private void AbrirDetalle(AuditoriaDto entry) => detalleSeleccionado = entry;

    private void CerrarDetalle() => detalleSeleccionado = null;

    private string EmpresaTexto(AuditoriaDto entry) =>
        entry.EmpresaId is Guid empresaId
            ? empresas.FirstOrDefault(empresa => empresa.Id == empresaId)?.Nombre ?? "—"
            : "—";

    private static readonly HashSet<string> CamposTecnicos = new(StringComparer.OrdinalIgnoreCase)
    {
        "id", "empresaId", "version", "createdAt", "createdBy", "updatedAt", "updatedBy",
        "fechaCreacion", "usuarioCreacion", "fechaModificacion", "usuarioModificacion",
        "contrasena", "password", "passwordHash", "token"
    };

    private static readonly Dictionary<string, string> NombresCampos = new(StringComparer.OrdinalIgnoreCase)
    {
        ["nombre"] = "Nombre", ["descripcion"] = "Descripción", ["activo"] = "Activo",
        ["estado"] = "Estado", ["fechaInicio"] = "Fecha de inicio", ["fechaFin"] = "Fecha de fin",
        ["fecha"] = "Fecha", ["ubicacion"] = "Ubicación", ["latitud"] = "Latitud",
        ["longitud"] = "Longitud", ["superficieHa"] = "Superficie (ha)",
        ["responsables"] = "Responsables", ["limites"] = "Límites", ["cultivoId"] = "Cultivo",
        ["tipoEventoId"] = "Tipo de evento", ["tipoTareaId"] = "Tipo de tarea",
        ["fechaPlanificada"] = "Fecha planificada", ["fechaRealizacion"] = "Fecha de realización",
        ["resultado"] = "Resultado", ["solucionoProblema"] = "Solucionó el problema",
        ["fechaComprobacion"] = "Fecha de comprobación", ["costo"] = "Costo",
        ["email"] = "Email", ["rol"] = "Rol", ["razonSocial"] = "Razón social"
    };

    private static IReadOnlyList<CambioAuditoria> Cambios(AuditoriaDto entry)
    {
        var antes = LeerObjeto(entry.DatosAnteriores);
        var despues = LeerObjeto(entry.DatosNuevos);

        return antes.Keys
            .Union(despues.Keys, StringComparer.OrdinalIgnoreCase)
            .Where(campo => !CamposTecnicos.Contains(campo))
            .Select(campo => new CambioAuditoria(
                NombresCampos.GetValueOrDefault(campo, SepararPascalCase(campo)),
                antes.GetValueOrDefault(campo),
                despues.GetValueOrDefault(campo)))
            .Where(cambio => !string.Equals(cambio.Anterior, cambio.Nuevo, StringComparison.Ordinal))
            .OrderBy(cambio => cambio.Campo)
            .ToList();
    }

    private static Dictionary<string, string?> LeerObjeto(string? json)
    {
        var resultado = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(json)) return resultado;

        try
        {
            using var documento = System.Text.Json.JsonDocument.Parse(json);
            if (documento.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return resultado;

            foreach (var propiedad in documento.RootElement.EnumerateObject())
            {
                resultado[propiedad.Name] = ValorLegible(propiedad.Value);
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // La API anterior podría contener una cadena no JSON. No se expone cruda.
        }

        return resultado;
    }

    private static string? ValorLegible(System.Text.Json.JsonElement valor) => valor.ValueKind switch
    {
        System.Text.Json.JsonValueKind.Null => null,
        System.Text.Json.JsonValueKind.String => FormatearTexto(valor.GetString()),
        System.Text.Json.JsonValueKind.True => "Sí",
        System.Text.Json.JsonValueKind.False => "No",
        System.Text.Json.JsonValueKind.Array => $"{valor.GetArrayLength()} elemento(s)",
        System.Text.Json.JsonValueKind.Object => "Datos relacionados",
        _ => valor.ToString()
    };

    /// <summary>
    /// Los JSON de auditoría guardan las fechas en ISO 8601 UTC. En la tabla de
    /// cambios se muestran en hora de Uruguay para que sean legibles.
    /// </summary>
    private static string? FormatearTexto(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto) || !texto.Contains('T'))
        {
            return texto;
        }

        return DateTimeOffset.TryParse(
            texto,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.RoundtripKind,
            out var fecha)
            ? SigaTime.Format(fecha.UtcDateTime)
            : texto;
    }

    private static string SepararPascalCase(string texto) =>
        System.Text.RegularExpressions.Regex.Replace(texto, "([a-z])([A-Z])", "$1 $2");

    private sealed record CambioAuditoria(string Campo, string? Anterior, string? Nuevo);

    private async Task DesplazarARegistrosAsync()
    {
        try
        {
            moduloUi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
            await moduloUi.InvokeVoidAsync("scrollToId", "auditoria-registros");
        }
        catch (JSDisconnectedException)
        {
            // El circuito se cerró mientras se paginaba.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Notificador.Cambio -= HandleChanged;

        if (moduloUi is not null)
        {
            try
            {
                await moduloUi.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
