@page "/insumos"
@implements IDisposable
@inject IServicioInsumos Service
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Insumos | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Catalogos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Catálogos</p>
            <h1>Insumos</h1>
            <p class="page-intro">Materiales disponibles para ejecutar tareas.</p>
            <a class="catalog-back-link" href="/catalogos"><span aria-hidden="true">←</span> Volver a catálogos</a>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewItem">Nuevo insumo</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <div class="card-header">
            <h2>Insumos (@items.Count)</h2>
        </div>

        @if (cargando && items.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!items.Any())
        {
            <p class="muted">No hay insumos registrados para la empresa activa.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Nombre</th><th>Empresa</th><th>Unidad</th><th>Precio</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr class="@(item.Activo ? null : "row-muted")">
                            <td>@item.Nombre</td>
                            <td>@(Contexto.EmpresaActiva?.Nombre ?? "—")</td>
                            <td>@(item.Unidad ?? "—")</td>
                            <td>@(item.PrecioUnitario?.ToString("C") ?? "—")</td>
                            <td>@(item.Activo ? "Activo" : "Desactivado")</td>
                            <td class="actions">
                                @if (CanManage)
                                {
                                    <button type="button" @onclick="() => Edit(item)">Editar</button>
                                    @if (item.Activo)
                                    {
                                        <button type="button" class="destructive" @onclick="() => Deactivate(item.Id)">Desactivar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editing ? "Editar insumo" : "Nuevo insumo")" OnClose="Reset">
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-field">
                    <label for="insumo-nombre">Nombre</label>
                    <InputText id="insumo-nombre" @bind-Value="model.Nombre" />
                </div>
                <div class="form-field">
                    <label for="insumo-unidad">Unidad</label>
                    <InputText id="insumo-unidad" @bind-Value="model.Unidad" />
                </div>
                <div class="form-field">
                    <label for="insumo-precio">Precio unitario</label>
                    <InputNumber id="insumo-precio" @bind-Value="model.PrecioUnitario" step="0.01" />
                </div>
                <div class="form-field">
                    <label class="checkbox-item">
                        <InputCheckbox @bind-Value="model.Activo" /> Activo
                    </label>
                </div>
                <div class="form-actions">
                    <button class="primary-button" type="submit">Guardar</button>
                    <button type="button" @onclick="Reset">Cancelar</button>
                </div>
            </EditForm>
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<InsumoDto> items = [];
    private InsumoForm model = new();
    private Guid? editingId;
    private long editingVersion;
    private bool editing;
    private bool formOpen;
    private string? error;
    private bool cargando;

    private bool CanManage => Auth.CanManage(SigaModule.Catalogos);

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            var lista = await Service.GetAllAsync(incluirInactivos: true);
            var activa = Contexto.EmpresaActivaId;
            items = activa is Guid empresaId
                ? lista.Where(item => item.EmpresaId == empresaId).ToList()
                : lista;
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Insumos && modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void Edit(InsumoDto item)
    {
        editing = true;
        editingId = item.Id;
        editingVersion = item.Version;
        formOpen = true;
        model = new InsumoForm
        {
            Nombre = item.Nombre,
            Unidad = item.Unidad,
            PrecioUnitario = item.PrecioUnitario,
            Activo = item.Activo
        };
        error = null;
    }

    private void NewItem()
    {
        Reset();
        formOpen = true;
    }

    private async Task Save()
    {
        error = null;

        try
        {
            if (editingId is Guid id)
            {
                var actualizado = await Service.UpdateAsync(new ActualizarInsumoDto
                {
                    Id = id,
                    Nombre = model.Nombre.Trim(),
                    Unidad = model.Unidad.Trim(),
                    PrecioUnitario = model.PrecioUnitario,
                    Activo = model.Activo,
                    Version = editingVersion
                });

                if (actualizado is null)
                {
                    error = "No se encontró el insumo.";
                    return;
                }
            }
            else
            {
                var empresaId = Contexto.EmpresaActivaId
                    ?? throw new InvalidOperationException("Seleccioná una empresa.");

                await Service.CreateAsync(new CrearInsumoDto
                {
                    EmpresaId = empresaId,
                    Nombre = model.Nombre.Trim(),
                    Unidad = model.Unidad.Trim(),
                    PrecioUnitario = model.PrecioUnitario
                });
            }

            Reset();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Deactivate(Guid id)
    {
        error = null;

        try
        {
            await Service.DeactivateAsync(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Reset()
    {
        formOpen = false;
        editing = false;
        editingId = null;
        editingVersion = 0;
        model = new InsumoForm();
        error = null;
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;

    private sealed class InsumoForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
        public string Unidad { get; set; } = "unidad";
        public decimal? PrecioUnitario { get; set; }
        public bool Activo { get; set; } = true;
    }
}
