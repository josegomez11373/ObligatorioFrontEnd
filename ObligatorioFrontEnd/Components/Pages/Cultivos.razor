@page "/cultivos"
@implements IDisposable
@inject IServicioCultivos CultivoService
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos
@using ObligatorioFrontEnd.Models

<PageTitle>Cultivos | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Catalogos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Catálogos</p>
            <h1>Cultivos</h1>
            <p class="page-intro">Administrá los cultivos disponibles para crear campañas en la empresa activa.</p>
            <a class="catalog-back-link" href="/catalogos"><span aria-hidden="true">←</span> Volver a catálogos</a>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="Nuevo">Nuevo cultivo</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <div class="card-header">
            <h2>Cultivos (@cultivos.Count)</h2>
        </div>

        @if (cargando && cultivos.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!cultivos.Any())
        {
            <p class="muted">No hay cultivos registrados para la empresa activa.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Nombre</th><th>Empresa</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var cultivo in cultivos)
                    {
                        <tr class="@(cultivo.Activo ? null : "row-muted")">
                            <td>@cultivo.Nombre</td>
                            <td>@(Contexto.EmpresaActiva?.Nombre ?? "—")</td>
                            <td>@(cultivo.Activo ? "Activo" : "Desactivado")</td>
                            <td class="actions">
                                @if (CanManage)
                                {
                                    <button type="button" @onclick="() => Editar(cultivo)">Editar</button>
                                    @if (cultivo.Activo)
                                    {
                                        <button type="button" class="destructive" @onclick="() => Deactivate(cultivo.Id)">Desactivar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editingId is null ? "Nuevo cultivo" : "Editar cultivo")" OnClose="Limpiar">
            <EditForm Model="model" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-field">
                    <label for="cultivo-nombre">Nombre</label>
                    <InputText id="cultivo-nombre" @bind-Value="model.Nombre" />
                </div>
                <div class="form-field">
                    <label class="checkbox-item">
                        <InputCheckbox @bind-Value="model.Activo" /> Activo
                    </label>
                </div>
                <div class="form-actions">
                    <button class="primary-button" type="submit">Guardar</button>
                    <button type="button" @onclick="Limpiar">Cancelar</button>
                </div>
            </EditForm>
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<CultivoDto> cultivos = [];
    private CultivoForm model = new();
    private Guid? editingId;
    private long editingVersion;
    private string? error;
    private bool formOpen;
    private bool cargando;

    private bool CanManage => Auth.CurrentUser is { Role: var role } && Permissions.CanManageCultivos(role);

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            var lista = await CultivoService.GetAllAsync(incluirInactivos: true);
            var activa = Contexto.EmpresaActivaId;
            cultivos = activa is Guid empresaId
                ? lista.Where(cultivo => cultivo.EmpresaId == empresaId).ToList()
                : lista;
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Cultivos && modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void Editar(CultivoDto item)
    {
        editingId = item.Id;
        editingVersion = item.Version;
        formOpen = true;
        model = new CultivoForm { Nombre = item.Nombre, Activo = item.Activo };
        error = null;
    }

    private void Nuevo()
    {
        Limpiar();
        formOpen = true;
    }

    private async Task Guardar()
    {
        error = null;

        try
        {
            if (editingId is Guid id)
            {
                var actualizado = await CultivoService.UpdateAsync(new ActualizarCultivoDto
                {
                    Id = id,
                    Nombre = model.Nombre.Trim(),
                    Activo = model.Activo,
                    Version = editingVersion
                });

                if (actualizado is null)
                {
                    error = "No se encontró el cultivo.";
                    return;
                }
            }
            else
            {
                var empresaId = Contexto.EmpresaActivaId
                    ?? throw new InvalidOperationException("Seleccioná una empresa.");

                await CultivoService.CreateAsync(new CrearCultivoDto
                {
                    EmpresaId = empresaId,
                    Nombre = model.Nombre.Trim()
                });
            }

            Limpiar();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Deactivate(Guid id)
    {
        error = null;

        try
        {
            await CultivoService.DeactivateAsync(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Limpiar()
    {
        formOpen = false;
        editingId = null;
        editingVersion = 0;
        model = new CultivoForm();
        error = null;
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;

    private sealed class CultivoForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }
}
