@page "/contratistas"
@implements IDisposable
@inject IServicioContratistas Service
@inject IServicioUsuarios UsuarioService
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Contratistas | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Catalogos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Catálogos</p>
            <h1>Contratistas</h1>
            <p class="page-intro">Servicios externos disponibles para las tareas. Vinculá cada contratista con su usuario para que vea solo lo asignado.</p>
            <a class="catalog-back-link" href="/catalogos"><span aria-hidden="true">←</span> Volver a catálogos</a>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewItem">Nuevo contratista</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <div class="card-header">
            <h2>Contratistas (@items.Count)</h2>
        </div>

        @if (cargando && items.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!items.Any())
        {
            <p class="muted">No hay contratistas registrados para la empresa activa.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Nombre</th><th>Empresa</th><th>Usuario vinculado</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr class="@(item.Activo ? null : "row-muted")">
                            <td>@item.Nombre</td>
                            <td>@(Contexto.EmpresaActiva?.Nombre ?? "—")</td>
                            <td>@UsuarioTexto(item)</td>
                            <td>@(item.Activo ? "Activo" : "Desactivado")</td>
                            <td class="actions">
                                @if (CanManage)
                                {
                                    <button type="button" @onclick="() => Edit(item)">Editar</button>
                                    @if (item.Activo)
                                    {
                                        <button type="button" class="destructive" @onclick="() => Deactivate(item.Id)">Desactivar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editing ? "Editar contratista" : "Nuevo contratista")" OnClose="Reset">
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-field">
                    <label for="contratista-nombre">Nombre</label>
                    <InputText id="contratista-nombre" @bind-Value="model.Nombre" />
                </div>
                <div class="form-field">
                    <label for="contratista-usuario">Usuario contratista</label>
                    <InputSelect id="contratista-usuario" @bind-Value="usuarioSeleccionado">
                        <option value="@Guid.Empty">Sin usuario vinculado</option>
                        @foreach (var usuario in UsuariosDisponibles)
                        {
                            <option value="@usuario.Id">@usuario.Nombre (@usuario.Email)</option>
                        }
                    </InputSelect>
                    @if (!UsuariosDisponibles.Any())
                    {
                        <p class="field-help">No hay usuarios con rol Contratista activos en la empresa. Creá uno desde Usuarios.</p>
                    }
                </div>
                <div class="form-field">
                    <label class="checkbox-item">
                        <InputCheckbox @bind-Value="model.Activo" /> Activo
                    </label>
                </div>
                <div class="form-actions">
                    <button class="primary-button" type="submit">Guardar</button>
                    <button type="button" @onclick="Reset">Cancelar</button>
                </div>
            </EditForm>
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<ContratistaDto> items = [];
    private IReadOnlyList<UsuarioDto> usuarios = [];
    private ContratistaForm model = new();
    private Guid? editingId;
    private long editingVersion;
    private bool editing;
    private bool formOpen;
    private string? error;
    private bool cargando;
    private Guid usuarioSeleccionado;

    private bool CanManage => Auth.CanManage(SigaModule.Catalogos);

    private IEnumerable<UsuarioDto> UsuariosDisponibles => usuarios
        .Where(usuario => usuario.Rol == RolApi.Contratista && usuario.Activo)
        .Where(usuario => !items.Any(contratista =>
            contratista.UsuarioId == usuario.Id && contratista.Id != (editingId ?? Guid.Empty)));

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            var lista = await Service.GetAllAsync(incluirInactivos: true);
            var activa = Contexto.EmpresaActivaId;
            items = activa is Guid empresaId
                ? lista.Where(item => item.EmpresaId == empresaId).ToList()
                : lista;
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }

        try
        {
            usuarios = await UsuarioService.GetAllAsync(incluirInactivos: false);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
            usuarios = [];
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Contratistas &&
            modulo != ModulosDatos.Usuarios &&
            modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private string UsuarioTexto(ContratistaDto item)
    {
        if (item.UsuarioId is not Guid usuarioId)
        {
            return "—";
        }

        if (!string.IsNullOrWhiteSpace(item.UsuarioNombre))
        {
            return string.IsNullOrWhiteSpace(item.UsuarioEmail)
                ? item.UsuarioNombre
                : $"{item.UsuarioNombre} ({item.UsuarioEmail})";
        }

        var usuario = usuarios.FirstOrDefault(candidato => candidato.Id == usuarioId);
        return usuario is null ? "Usuario no disponible" : $"{usuario.Nombre} ({usuario.Email})";
    }

    private void Edit(ContratistaDto item)
    {
        editing = true;
        editingId = item.Id;
        editingVersion = item.Version;
        formOpen = true;
        model = new ContratistaForm { Nombre = item.Nombre, Activo = item.Activo };
        usuarioSeleccionado = item.UsuarioId ?? Guid.Empty;
        error = null;
    }

    private void NewItem()
    {
        Reset();
        formOpen = true;
    }

    private async Task Save()
    {
        error = null;

        try
        {
            var usuarioId = usuarioSeleccionado == Guid.Empty ? (Guid?)null : usuarioSeleccionado;

            if (editingId is Guid id)
            {
                var actualizado = await Service.UpdateAsync(new ActualizarContratistaDto
                {
                    Id = id,
                    Nombre = model.Nombre.Trim(),
                    UsuarioId = usuarioId,
                    Activo = model.Activo,
                    Version = editingVersion
                });

                if (actualizado is null)
                {
                    error = "No se encontró el contratista.";
                    return;
                }
            }
            else
            {
                var empresaId = Contexto.EmpresaActivaId
                    ?? throw new InvalidOperationException("Seleccioná una empresa.");

                await Service.CreateAsync(new CrearContratistaDto
                {
                    EmpresaId = empresaId,
                    Nombre = model.Nombre.Trim(),
                    UsuarioId = usuarioId
                });
            }

            Reset();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Deactivate(Guid id)
    {
        error = null;

        try
        {
            await Service.DeactivateAsync(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Reset()
    {
        formOpen = false;
        editing = false;
        editingId = null;
        editingVersion = 0;
        model = new ContratistaForm();
        usuarioSeleccionado = Guid.Empty;
        error = null;
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;

    private sealed class ContratistaForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }
}
