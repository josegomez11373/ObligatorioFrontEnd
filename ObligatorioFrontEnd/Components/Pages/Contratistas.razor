@page "/contratistas"
@implements IDisposable
@inject ContratistaService Service
@inject EmpresaService EmpresaService
@inject UserService UserService
@inject IAuthService Auth

<PageTitle>Contratistas | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Catalogos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Catálogos</p>
            <h1>Contratistas</h1>
            <p class="page-intro">Servicios externos disponibles para las tareas. Vinculá cada contratista con su usuario para que vea solo lo asignado.</p>
            <a class="catalog-back-link" href="/catalogos"><span aria-hidden="true">←</span> Volver a catálogos</a>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewItem">Nuevo contratista</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
            <div class="card-header">
                <h2>Contratistas (@items.Count)</h2>
                @if (IsAdminGeneral)
                {
                    <div class="form-field compact-field">
                        <label for="contratista-empresa">Empresa</label>
                        <select id="contratista-empresa" @bind="empresaFiltro" @bind:after="OnEmpresaChanged">
                            @foreach (var empresa in EmpresaService.GetAll())
                            {
                                <option value="@empresa.Id">@empresa.Nombre</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @if (!items.Any())
            {
                <p class="muted">No hay contratistas registrados para la empresa seleccionada.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Nombre</th><th>Empresa</th><th>Usuario vinculado</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(item.Activo ? null : "row-muted")">
                                <td>@item.Nombre</td>
                                <td>@(EmpresaService.GetById(item.EmpresaId)?.Nombre ?? "—")</td>
                                <td>@UsuarioTexto(item)</td>
                                <td>@(item.Activo ? "Activo" : "Desactivado")</td>
                                <td class="actions">
                                    @if (CanManage)
                                    {
                                        <button type="button" @onclick="() => Edit(item)">Editar</button>
                                        @if (item.Activo)
                                        {
                                            <button type="button" class="destructive" @onclick="() => Deactivate(item.Id)">Desactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editing ? "Editar contratista" : "Nuevo contratista")" OnClose="Reset">
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="form-field">
                        <label for="contratista-nombre">Nombre</label>
                        <InputText id="contratista-nombre" @bind-Value="model.Nombre" />
                    </div>
                    <div class="form-field">
                        <label for="contratista-usuario">Usuario contratista</label>
                        <InputSelect id="contratista-usuario" @bind-Value="usuarioSeleccionado">
                            <option value="@Guid.Empty">Sin usuario vinculado</option>
                            @foreach (var usuario in UsuariosDisponibles)
                            {
                                <option value="@usuario.Id">@usuario.Nombre (@usuario.Email)</option>
                            }
                        </InputSelect>
                        @if (!UsuariosDisponibles.Any())
                        {
                            <p class="field-help">No hay usuarios con rol Contratista activos en la empresa. Creá uno desde Usuarios.</p>
                        }
                    </div>
                    <div class="form-field">
                        <label class="checkbox-item">
                            <InputCheckbox @bind-Value="model.Activo" /> Activo
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="primary-button" type="submit">Guardar</button>
                        <button type="button" @onclick="Reset">Cancelar</button>
                    </div>
                </EditForm>
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<Contratista> items = [];
    private Contratista model = new();
    private bool editing;
    private bool formOpen;
    private string? error;
    private string empresaFiltro = string.Empty;
    private Guid usuarioSeleccionado;

    private bool IsAdminGeneral => Auth.CurrentUser?.Role == UserRole.AdministradorGeneral;
    private bool CanManage => Auth.CanManage(SigaModule.Catalogos);
    private Guid EmpresaId => Guid.TryParse(empresaFiltro, out var id) ? id : Guid.Empty;

    private IEnumerable<Usuario> UsuariosDisponibles => UserService.GetAll()
        .Where(user => user.Rol == UserRole.Contratista)
        .Where(user => EmpresaId == Guid.Empty || user.EmpresaId == EmpresaId)
        .Where(user => !Service.GetAll(true).Any(contratista =>
            contratista.UsuarioId == user.Id && contratista.Id != model.Id));

    protected override void OnInitialized()
    {
        Service.StateChanged += Load;
        empresaFiltro = (Auth.CurrentUser?.EmpresaId ?? EmpresaService.GetAll().FirstOrDefault()?.Id ?? Guid.Empty).ToString();
        Load();
    }

    private void Load()
    {
        items = Service.GetAll(true)
            .Where(item => EmpresaId == Guid.Empty || item.EmpresaId == EmpresaId)
            .ToList();
        InvokeAsync(StateHasChanged);
    }

    private void OnEmpresaChanged()
    {
        Reset();
        Load();
    }

    private string UsuarioTexto(Contratista item)
    {
        if (item.UsuarioId is not Guid usuarioId)
        {
            return "—";
        }

        var usuario = UserService.GetById(usuarioId);
        return usuario is null ? "Usuario no disponible" : $"{usuario.Nombre} ({usuario.Email})";
    }

    private void Edit(Contratista item)
    {
        editing = true;
        formOpen = true;
        empresaFiltro = item.EmpresaId.ToString();
        model = item with { };
        usuarioSeleccionado = item.UsuarioId ?? Guid.Empty;
        error = null;
    }

    private void NewItem()
    {
        Reset();
        formOpen = true;
    }

    private void Save()
    {
        error = null;

        try
        {
            var draft = model with
            {
                UsuarioId = usuarioSeleccionado == Guid.Empty ? null : usuarioSeleccionado
            };

            if (editing)
            {
                Service.Update(draft);
            }
            else
            {
                if (EmpresaId == Guid.Empty)
                {
                    throw new InvalidOperationException("Seleccioná una empresa.");
                }

                Service.Create(draft with { EmpresaId = EmpresaId });
            }

            Reset();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Deactivate(Guid id)
    {
        error = null;

        try
        {
            Service.Deactivate(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Reset()
    {
        formOpen = false;
        editing = false;
        model = new Contratista();
        usuarioSeleccionado = Guid.Empty;
        error = null;
    }

    public void Dispose() => Service.StateChanged -= Load;
}
