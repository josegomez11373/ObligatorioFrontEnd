@page "/tipos-evento"
@implements IDisposable
@inject TipoEventoService Service
@inject EmpresaService EmpresaService
@inject IAuthService Auth

<PageTitle>Tipos de evento | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Catalogos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Catálogos</p>
            <h1>Tipos de evento</h1>
            <p class="page-intro">Clasificaciones para registrar eventos.</p>
            <a class="catalog-back-link" href="/catalogos"><span aria-hidden="true">←</span> Volver a catálogos</a>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewItem">Nuevo tipo</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
            <div class="card-header">
                <h2>Tipos (@items.Count)</h2>
                @if (IsAdminGeneral)
                {
                    <div class="form-field compact-field">
                        <label for="tipo-evento-empresa">Empresa</label>
                        <select id="tipo-evento-empresa" @bind="empresaFiltro" @bind:after="OnEmpresaChanged">
                            @foreach (var empresa in EmpresaService.GetAll())
                            {
                                <option value="@empresa.Id">@empresa.Nombre</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @if (!items.Any())
            {
                <p class="muted">No hay tipos de evento registrados para la empresa seleccionada.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Nombre</th><th>Empresa</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(item.Activo ? null : "row-muted")">
                                <td>@item.Nombre</td>
                                <td>@(EmpresaService.GetById(item.EmpresaId)?.Nombre ?? "—")</td>
                                <td>@(item.Activo ? "Activo" : "Desactivado")</td>
                                <td class="actions">
                                    @if (CanManage)
                                    {
                                        <button type="button" @onclick="() => Edit(item)">Editar</button>
                                        @if (item.Activo)
                                        {
                                            <button type="button" class="destructive" @onclick="() => Deactivate(item.Id)">Desactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editing ? "Editar tipo de evento" : "Nuevo tipo de evento")" OnClose="Reset">
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="form-field">
                        <label for="tipo-evento-nombre">Nombre</label>
                        <InputText id="tipo-evento-nombre" @bind-Value="model.Nombre" />
                    </div>
                    <div class="form-field">
                        <label class="checkbox-item">
                            <InputCheckbox @bind-Value="model.Activo" /> Activo
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="primary-button" type="submit">Guardar</button>
                        <button type="button" @onclick="Reset">Cancelar</button>
                    </div>
                </EditForm>
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<TipoEvento> items = [];
    private TipoEventoForm model = new();
    private bool editing;
    private bool formOpen;
    private string? error;
    private string empresaFiltro = string.Empty;

    private bool IsAdminGeneral => Auth.CurrentUser?.Role == UserRole.AdministradorGeneral;
    private bool CanManage => Auth.CanManage(SigaModule.Catalogos);
    private Guid EmpresaId => Guid.TryParse(empresaFiltro, out var id) ? id : Guid.Empty;

    protected override void OnInitialized()
    {
        Service.StateChanged += Load;
        empresaFiltro = (Auth.CurrentUser?.EmpresaId ?? EmpresaService.GetAll().FirstOrDefault()?.Id ?? Guid.Empty).ToString();
        Load();
    }

    private void Load()
    {
        items = Service.GetAll(true)
            .Where(item => EmpresaId == Guid.Empty || item.EmpresaId == EmpresaId)
            .ToList();
        InvokeAsync(StateHasChanged);
    }

    private void OnEmpresaChanged()
    {
        Reset();
        Load();
    }

    private void Edit(TipoEvento item)
    {
        editing = true;
        formOpen = true;
        empresaFiltro = item.EmpresaId.ToString();
        model = new TipoEventoForm { Id = item.Id, Nombre = item.Nombre, Activo = item.Activo };
        error = null;
    }

    private void NewItem()
    {
        Reset();
        formOpen = true;
    }

    private void Save()
    {
        error = null;

        try
        {
            if (editing)
            {
                Service.Update(model.Id, model.Nombre, model.Activo);
            }
            else
            {
                if (EmpresaId == Guid.Empty)
                {
                    throw new InvalidOperationException("Seleccioná una empresa.");
                }

                Service.Create(EmpresaId, model.Nombre);
            }

            Reset();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Deactivate(Guid id)
    {
        error = null;

        try
        {
            Service.Deactivate(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private void Reset()
    {
        formOpen = false;
        editing = false;
        model = new TipoEventoForm();
        error = null;
    }

    public void Dispose() => Service.StateChanged -= Load;

    private sealed class TipoEventoForm
    {
        public Guid Id { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }
}
