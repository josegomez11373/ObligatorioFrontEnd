@page "/historial"
@implements IDisposable
@inject IServicioCampanas CampanaService
@inject IServicioEventos EventoService
@inject IServicioTareas TareaService
@inject IServicioFotografias FotografiaService
@inject NotificadorDatos Notificador

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Historial | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Historial">
    <section class="page-header">
        <div>
            <p class="eyebrow">Seguimiento agrícola</p>
            <h1>Historial de campaña</h1>
            <p class="page-intro">Consultá cronológicamente los eventos, fotografías, tareas y resultados de una campaña.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <div class="card-header">
            <div>
                <p class="eyebrow">Consulta</p>
                <h2>Filtrar historial</h2>
            </div>
            @if (selectedCampanaId != Guid.Empty)
            {
                <span class="report-count">@Entries.Count() registros</span>
            }
        </div>
        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="campana">Campaña</label>
                <InputSelect id="campana" @bind-Value="selectedCampanaId" @bind-Value:after="CargarFotosCampanaAsync">
                    <option value="@Guid.Empty">Seleccioná una campaña...</option>
                    @foreach (var campana in campanas)
                    {
                        <option value="@campana.Id">@campana.Nombre · @campana.Estado.DisplayName()</option>
                    }
                </InputSelect>
            </div>
            <div class="form-field compact-field">
                <label for="filtro-historial">Filtrar</label>
                <select id="filtro-historial" @bind="filter">
                    <option value="">Todo</option>
                    <option value="Evento">Solo eventos</option>
                    <option value="Tarea">Solo tareas</option>
                </select>
            </div>
        </div>

        @if (selectedCampanaId != Guid.Empty)
        {
            var entries = Entries.ToList();
            if (cargando && entries.Count == 0)
            {
                <p>Cargando...</p>
            }
            else if (!entries.Any())
            {
                <p class="muted">Todavía no hay registros para esta campaña.</p>
            }
            else
            {
                <ol class="timeline">
                    @foreach (var entry in entries)
                    {
                        <li>
                            <time>@entry.Fecha.ToString("dd MMM yyyy")</time>
                            <div>
                                <strong>@entry.Titulo</strong>
                                <p>@entry.Descripcion</p>
                                <small>
                                    @entry.Detalle
                                    @if (entry.Costo is decimal costo)
                                    {
                                        <span> · Costo: @costo.ToString("C")</span>
                                    }
                                </small>
                                @if (entry.Fotos.Count > 0)
                                {
                                    <div class="photo-grid photo-grid--compact">
                                        @foreach (var foto in entry.Fotos)
                                        {
                                            <figure class="photo-card @(foto.Visible ? null : "photo-hidden")">
                                                @if (foto.Visible && fotoUrls.GetValueOrDefault(foto.Id) is string url)
                                                {
                                                    <img src="@url" alt="@foto.NombreArchivo" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="photo-placeholder">Oculta</div>
                                                }
                                                <figcaption>@foto.NombreArchivo</figcaption>
                                            </figure>
                                        }
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        }
    </section>
</RoleGuard>

@code {
    private IReadOnlyList<CampanaDto> campanas = [];
    private IReadOnlyList<EventoDto> eventos = [];
    private IReadOnlyList<TareaDto> tareas = [];
    private Guid selectedCampanaId;
    private string filter = string.Empty;
    private string? error;
    private bool cargando;
    private readonly Dictionary<Guid, string?> fotoUrls = [];

    private sealed record HistoryEntry(
        DateTime Fecha,
        string Tipo,
        string Titulo,
        string Descripcion,
        string Detalle,
        decimal? Costo,
        IReadOnlyList<FotografiaDto> Fotos);

    private IEnumerable<HistoryEntry> Entries
    {
        get
        {
            if (selectedCampanaId == Guid.Empty)
            {
                return [];
            }

            var eventosCampana = eventos
                .Where(evento => AsignacionIdsCampana().Contains(evento.CampanaPotreroId))
                .Select(evento => new HistoryEntry(
                    evento.Fecha,
                    "Evento",
                    $"{evento.TipoEventoNombre ?? "Evento"} · {evento.PotreroNombre ?? "—"}",
                    evento.Descripcion ?? "—",
                    $"Registrado por {evento.RegistradoPor ?? "—"} · {evento.Estado}",
                    null,
                    evento.Fotografias));

            var tareasCampana = tareas
                .Where(tarea => AsignacionIdsCampana().Contains(tarea.CampanaPotreroId))
                .Select(tarea => new HistoryEntry(
                    tarea.FechaPlanificada ?? tarea.FechaCreacion,
                    "Tarea",
                    $"{tarea.TipoTareaNombre ?? "Tarea"} · {tarea.PotreroNombre ?? "—"}",
                    tarea.Descripcion ?? "—",
                    $"Estado: {tarea.Estado}{(string.IsNullOrWhiteSpace(tarea.Resultado) ? string.Empty : $" · Resultado: {tarea.Resultado}")}",
                    tarea.Costo,
                    []));

            var all = eventosCampana.Concat(tareasCampana);
            return (filter switch
            {
                "Evento" => all.Where(entry => entry.Tipo == "Evento"),
                "Tarea" => all.Where(entry => entry.Tipo == "Tarea"),
                _ => all
            }).OrderByDescending(entry => entry.Fecha);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;
        error = null;

        try
        {
            campanas = await CampanaService.GetAllAsync(incluirAnuladas: true);
            eventos = await EventoService.GetAllAsync(incluirAnulados: true);
            tareas = await TareaService.GetAllAsync(incluirAnuladas: true);
            await CargarFotosCampanaAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private HashSet<Guid> AsignacionIdsCampana() =>
        campanas
            .Where(campana => campana.Id == selectedCampanaId)
            .SelectMany(campana => campana.Potreros.Select(potrero => potrero.Id))
            .ToHashSet();

    private async Task CargarFotosCampanaAsync()
    {
        fotoUrls.Clear();

        if (selectedCampanaId == Guid.Empty)
        {
            return;
        }

        var asignacionIds = AsignacionIdsCampana();

        foreach (var evento in eventos.Where(evento => asignacionIds.Contains(evento.CampanaPotreroId)))
        {
            foreach (var foto in evento.Fotografias)
            {
                fotoUrls[foto.Id] = await FotografiaService.ObtenerDataUrlAsync(foto);
            }
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Eventos &&
            modulo != ModulosDatos.Fotos &&
            modulo != ModulosDatos.Tareas &&
            modulo != ModulosDatos.Campanas &&
            modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;
}
