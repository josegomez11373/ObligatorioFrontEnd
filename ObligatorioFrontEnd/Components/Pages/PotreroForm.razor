@using ObligatorioFrontEnd.Api.Contratos
@using ObligatorioFrontEnd.Models

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-field">
        <label for="est">Establecimiento</label>
        <InputSelect id="est" @bind-Value="Model.EstablecimientoId">
            <option value="@Guid.Empty">Seleccioná un establecimiento...</option>
            @foreach (var est in Establecimientos.Where(e => e.Activo || e.Id == Model.EstablecimientoId))
            {
                <option value="@est.Id">@est.Nombre</option>
            }
        </InputSelect>
    </div>

    <div class="form-field">
        <label for="nombre">Nombre</label>
        <InputText id="nombre" @bind-Value="Model.Nombre" />
    </div>

    <div class="form-field">
        <label for="sup">Superficie (ha)</label>
        <InputNumber id="sup" @bind-Value="Model.SuperficieHa" />
    </div>

    <div class="form-field">
        <label for="limites">Límites</label>
        <InputText id="limites" @bind-Value="Model.Limites" />
    </div>

    <div class="form-field">
        <label>
            <InputCheckbox @bind-Value="Model.Activo" /> Activo
        </label>
    </div>

    <div class="form-actions">
        <button class="primary-button" type="submit">Guardar</button>
        <button type="button" @onclick="HandleCancel">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public PotreroEditModel Model { get; set; } = new();

    /// <summary>Establecimientos de la empresa activa.</summary>
    [Parameter]
    public IReadOnlyList<EstablecimientoDto> Establecimientos { get; set; } = [];

    [Parameter]
    public EventCallback<PotreroEditModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync(Model);

    private Task HandleCancel() => OnCancel.InvokeAsync();
}
