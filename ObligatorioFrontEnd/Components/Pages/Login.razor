@page "/login"
@layout EmptyLayout
@inject IAuthService Auth
@inject IContextoEmpresa Contexto
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | SIGA</PageTitle>

<main class="login-page">
    <section class="login-intro">
        <a class="brand brand-light" href="/login"><span class="brand-mark">S</span><span><strong>SIGA</strong><small>Gestión agropecuaria</small></span></a>
        <div>
            <p class="eyebrow">Sistema Integral de Gestión Agropecuaria</p>
            <h1>La información del campo, en un solo lugar.</h1>
            <p>Registra campañas, eventos y tareas con una vista clara de cada establecimiento.</p>
        </div>
        <p class="intro-note">Acceso con las credenciales de SIGA.</p>
    </section>

    <section class="login-panel" aria-labelledby="login-title">
        <div class="login-card">
            <p class="eyebrow">Acceso seguro</p>
            <h2 id="login-title">Iniciar sesión</h2>
            <p class="muted">Ingresá con tu email y contraseña.</p>

            <EditForm Model="form" OnValidSubmit="SignIn">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="email">Email</label>
                    <InputText id="email" type="email" autocomplete="username" @bind-Value="form.Email" />
                </div>
                <div class="form-field">
                    <label for="password">Contraseña</label>
                    <InputText id="password" type="password" autocomplete="current-password" @bind-Value="form.Password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="form-error" role="alert">@error</p>
                }
                <button class="primary-button" type="submit" disabled="@submitting">
                    @(submitting ? "Ingresando..." : "Ingresar a SIGA") <span>→</span>
                </button>
            </EditForm>

            <p class="demo-hint">Contraseña del ambiente de demostración: <code>siga2026</code></p>
        </div>
    </section>
</main>

@code {
    private readonly LoginForm form = new() { Email = "admin@siga.demo" };
    private string? error;
    private bool submitting;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task SignIn()
    {
        error = null;
        submitting = true;

        try
        {
            if (!await Auth.LoginAsync(form.Email, form.Password))
            {
                error = "Email o contraseña incorrectos.";
                return;
            }

            await Contexto.InicializarAsync();
            Navigation.NavigateTo("/", replace: true);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private sealed class LoginForm
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
