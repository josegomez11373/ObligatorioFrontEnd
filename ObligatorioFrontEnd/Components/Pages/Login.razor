@page "/login"
@layout EmptyLayout
@inject DemoAuthService Auth
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | SIGA</PageTitle>

<main class="login-page">
    <section class="login-intro">
        <a class="brand brand-light" href="/login"><span class="brand-mark">S</span><span><strong>SIGA</strong><small>Gestión agropecuaria</small></span></a>
        <div>
            <p class="eyebrow">Sistema Integral de Gestión Agropecuaria</p>
            <h1>La información del campo, en un solo lugar.</h1>
            <p>Registra campañas, eventos y tareas con una vista clara de cada establecimiento.</p>
        </div>
        <p class="intro-note">Ambiente de demostración para la primera versión de SIGA.</p>
    </section>

    <section class="login-panel" aria-labelledby="login-title">
        <div class="login-card">
            <p class="eyebrow">Acceso seguro</p>
            <h2 id="login-title">Iniciar sesión</h2>
            <p class="muted">Elegí un perfil de prueba para recorrer la aplicación.</p>

            <EditForm Model="form" OnValidSubmit="SignIn">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="email">Usuario de prueba</label>
                    <InputSelect id="email" @bind-Value="form.Email">
                        @foreach (var user in Auth.Users)
                        {
                            <option value="@user.Email">@user.Role.DisplayName() — @user.Email</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="password">Contraseña</label>
                    <InputText id="password" type="password" @bind-Value="form.Password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="form-error" role="alert">@error</p>
                }
                <button class="primary-button" type="submit">Ingresar a SIGA <span>→</span></button>
            </EditForm>

            <p class="demo-hint">Contraseña de demostración: <code>siga2026</code></p>
        </div>
    </section>
</main>

@code {
    private readonly LoginForm form = new() { Email = "admin@siga.demo" };
    private string? error;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private void SignIn()
    {
        error = Auth.Login(form.Email, form.Password)
            ? null
            : "La contraseña de demostración no es correcta.";

        if (error is null)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private sealed class LoginForm
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
