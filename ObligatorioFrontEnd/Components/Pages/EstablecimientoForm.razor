@using ObligatorioFrontEnd.Models
@inject EmpresaService EmpresaService
@inject IUserScope UserScope

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-field">
        <label for="empresa">Empresa</label>
        <InputSelect id="empresa" @bind-Value="Model.EmpresaId" disabled="@(!CanSelectEmpresa)">
            <option value="@Guid.Empty">Seleccioná una empresa...</option>
            @foreach (var org in EmpresaService.GetAll().Where(e => e.Activo || e.Id == Model.EmpresaId))
            {
                <option value="@org.Id">@org.Nombre</option>
            }
        </InputSelect>
    </div>

    <div class="form-field">
        <label for="nombre">Nombre</label>
        <InputText id="nombre" @bind-Value="Model.Nombre" />
    </div>

    <div class="form-field">
        <label for="sup">Superficie (ha)</label>
        <InputNumber id="sup" @bind-Value="Model.SuperficieHa" />
    </div>

    <div class="form-field">
        <label for="ubicacion">Ubicación</label>
        <InputText id="ubicacion" @bind-Value="Model.Ubicacion" />
    </div>

    <div class="form-field">
        <label for="responsables">Responsables</label>
        <InputText id="responsables" @bind-Value="Model.Responsables" />
    </div>

    <div class="form-field">
        <label>
            <InputCheckbox @bind-Value="Model.Activo" /> Activo
        </label>
    </div>

    <div class="form-actions">
        <button class="primary-button" type="submit">Guardar</button>
        <button type="button" @onclick="HandleCancel">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public EstablecimientoEditModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<EstablecimientoEditModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool CanSelectEmpresa => UserScope.CurrentUser?.Role == UserRole.AdministradorGeneral;

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync(Model);

    private Task HandleCancel() => OnCancel.InvokeAsync();
}
