@page "/tareas"
@implements IDisposable
@inject IServicioTareas TareaService
@inject IServicioTiposTarea TipoTareaService
@inject IServicioCampanas CampanaService
@inject IServicioEventos EventoService
@inject IServicioUsuarios UserService
@inject IServicioContratistas ContratistaService
@inject IServicioInsumos InsumoService
@inject IServicioMaquinaria MaquinariaService
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Tareas | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Tareas">
    <section class="page-header">
        <div>
            <p class="eyebrow">Ejecución agrícola</p>
            <h1>Tareas</h1>
            <p class="page-intro">Planificá acciones sobre una campaña, asigná responsables y registrá costos, resultados y verificación.</p>
        </div>
        @if (CanCreate)
        {
            <button class="primary-button primary-button--inline" @onclick="NewTarea">Nueva tarea</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <p class="form-error" role="alert">@pageError</p>
    }

    <section class="card">
        <h2>Tareas</h2>

        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="buscar-tarea">Buscar</label>
                <input id="buscar-tarea" @bind="search" @bind:event="oninput" placeholder="Descripción, potrero o ejecutor" />
            </div>
            <div class="form-field compact-field">
                <label for="filtro-estado-tarea">Estado</label>
                <select id="filtro-estado-tarea" @bind="filterEstado">
                    <option value="">Todos</option>
                    @foreach (var estado in Enum.GetValues<EstadoTarea>())
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>
        </div>

        @if (cargando && tareas.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!Filtered.Any())
        {
            <p class="muted">No hay tareas que coincidan con los filtros.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Tipo</th><th>Descripción</th><th>Campaña / potrero</th><th>Fecha</th><th>Ejecutor</th><th>Recursos</th><th>Costo</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var tarea in Filtered)
                    {
                        <tr class="@(tarea.Estado == EstadoTarea.Anulada ? "row-muted" : null)">
                            <td>@(tarea.TipoTareaNombre ?? "—")</td>
                            <td>@tarea.Descripcion</td>
                            <td>@ContextoTexto(tarea.CampanaPotreroId)</td>
                            <td>@(tarea.FechaPlanificada?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@ExecutorName(tarea)</td>
                            <td>@tarea.Recursos.Count</td>
                            <td>@((tarea.Costo ?? 0).ToString("C"))</td>
                            <td>@tarea.Estado</td>
                            <td class="actions">
                                <button @onclick="() => SelectTask(tarea.Id)">Detalle</button>
                                @if (CanCreate && tarea.Estado is EstadoTarea.Planificada or EstadoTarea.Asignada)
                                {
                                    <button @onclick="() => EditTarea(tarea.Id)">Editar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (CanCreate)
    {
        <SidePanel IsOpen="formOpen" Title="@(model.Id == Guid.Empty ? "Crear tarea" : "Editar tarea")" OnClose="Cancel">
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-field">
                    <label for="tarea-campana">Campaña y potrero</label>
                    <InputSelect id="tarea-campana" @bind-Value="model.CampanaPotreroId">
                        <option value="@Guid.Empty">Seleccioná una campaña y potrero...</option>
                        @foreach (var campana in campanas.Where(item => item.Estado is EstadoCampana.Planificada or EstadoCampana.Activa))
                        {
                            @foreach (var potrero in campana.Potreros)
                            {
                                <option value="@potrero.Id">@campana.Nombre · @potrero.PotreroNombre</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label for="tarea-tipo">Tipo de tarea</label>
                    <InputSelect id="tarea-tipo" @bind-Value="model.TipoTareaId">
                        <option value="@Guid.Empty">Seleccioná un tipo...</option>
                        @foreach (var tipo in tiposTarea)
                        {
                            <option value="@tipo.Id">@tipo.Nombre</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label for="tarea-evento">Evento que responde (opcional)</label>
                    <InputSelect id="tarea-evento" @bind-Value="model.EventoId">
                        <option value="">Sin evento asociado</option>
                        @foreach (var evento in EventosDisponibles)
                        {
                            <option value="@evento.Id">@evento.Fecha.ToString("dd/MM/yyyy") · @evento.Descripcion</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label for="tarea-descripcion">Descripción</label>
                    <InputTextArea id="tarea-descripcion" @bind-Value="model.Descripcion" rows="3" />
                </div>

                <div class="form-field">
                    <label for="tarea-fecha">Fecha planificada</label>
                    <InputDate id="tarea-fecha" @bind-Value="model.FechaPlanificada" />
                </div>

                <div class="form-actions">
                    <button class="primary-button" type="submit">Guardar tarea</button>
                    <button type="button" @onclick="Cancel">Cancelar</button>
                </div>
            </EditForm>
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }

    @if (selected is not null)
    {
        <section class="card">
            <div class="card-header">
                <div>
                    <h2>@selected.Descripcion</h2>
                    <p class="muted">@(selected.TipoTareaNombre ?? "—") · @ContextoTexto(selected.CampanaPotreroId) · @(selected.FechaPlanificada?.ToString("dd/MM/yyyy") ?? "—")</p>
                    <p class="muted">Estado: <strong>@selected.Estado</strong> · Ejecutor: @ExecutorName(selected) · Costo: @((selected.Costo ?? 0).ToString("C"))</p>
                    @if (selected.FechaRealizacion is DateTime realizada)
                    {
                        <p class="muted">Realizada: @SigaTime.Format(realizada)</p>
                    }
                    @if (selected.FechaComprobacion is DateTime verificada)
                    {
                        <p class="muted">Verificada: @SigaTime.Format(verificada) por @(selected.VerificadaPor ?? "—")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(selected.Resultado))
                    {
                        <p class="muted">Resultado: @selected.Resultado</p>
                    }
                    @if (selected.SolucionoProblema is bool soluciono)
                    {
                        <p class="muted">¿Solucionó el problema? @(soluciono ? "Sí" : "No")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(selected.MotivoAnulacion))
                    {
                        <p class="muted">Motivo de anulación: @selected.MotivoAnulacion</p>
                    }
                </div>
                <button @onclick="() => selected = null">Cerrar</button>
            </div>

            @if (selected.Recursos.Count > 0)
            {
                <h3>Recursos registrados</h3>
                <table class="table">
                    <thead><tr><th>Tipo</th><th>Recurso</th><th>Cantidad</th><th>Costo</th></tr></thead>
                    <tbody>
                        @foreach (var recurso in selected.Recursos)
                        {
                            <tr>
                                <td>@recurso.Tipo</td>
                                <td>@(recurso.Nombre ?? "—")</td>
                                <td>@recurso.Cantidad.ToString("G")</td>
                                <td>@((recurso.CostoTotal ?? 0).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (CanAssign && selected.Estado is EstadoTarea.Planificada or EstadoTarea.Asignada)
            {
                <div class="inline-confirm">
                    <h3>Asignación</h3>
                    <div class="filter-row">
                        <div class="form-field compact-field">
                            <label for="ejecutor">Ejecutor</label>
                            <select id="ejecutor" @bind="executorKey">
                                <option value="">Seleccioná un ejecutor...</option>
                                @foreach (var option in ExecutorOptions)
                                {
                                    <option value="@option.Key">@option.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="AssignSelected">Asignar ejecutor</button>
                    </div>
                </div>
            }

            @if (CanExecute && selected.Estado is EstadoTarea.Asignada)
            {
                <div class="inline-confirm">
                    <h3>Agregar recurso</h3>
                    <div class="filter-row">
                        <div class="form-field compact-field">
                            <label for="recurso-tipo">Tipo</label>
                            <select id="recurso-tipo" @bind="recursoTipo">
                                <option value="@TipoRecursoTarea.Insumo">Insumo</option>
                                <option value="@TipoRecursoTarea.Maquinaria">Maquinaria</option>
                            </select>
                        </div>
                        <div class="form-field compact-field">
                            <label for="recurso">Recurso</label>
                            <select id="recurso" @bind="recursoId">
                                <option value="@Guid.Empty">Seleccioná...</option>
                                @foreach (var recurso in RecursosDisponibles)
                                {
                                    <option value="@recurso.Id">@recurso.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="form-field compact-field">
                            <label for="recurso-cantidad">Cantidad</label>
                            <input id="recurso-cantidad" type="number" min="0.01" step="0.01" @bind="recursoCantidad" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="AddResource">Agregar a la realización</button>
                    </div>

                    @if (recursosPendientes.Count > 0)
                    {
                        <p class="field-help">Se registrarán al marcar la tarea como realizada.</p>
                        <table class="table">
                            <thead><tr><th>Tipo</th><th>Recurso</th><th>Cantidad</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var recurso in recursosPendientes)
                                {
                                    <tr>
                                        <td>@recurso.Tipo</td>
                                        <td>@RecursoNombre(recurso)</td>
                                        <td>@recurso.Cantidad.ToString("G")</td>
                                        <td class="actions">
                                            <button class="destructive" @onclick="() => RemovePending(recurso)">Quitar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <div class="inline-confirm">
                    <h3>Marcar como realizada</h3>
                    <div class="form-field">
                        <label for="resultado">Resultado</label>
                        <textarea id="resultado" @bind="resultado" rows="2" placeholder="Resultado de la tarea"></textarea>
                    </div>
                    <div class="filter-row">
                        <div class="form-field compact-field">
                            <label for="fecha-realizacion">Fecha de realización</label>
                            <InputDate id="fecha-realizacion" @bind-Value="fechaRealizacion" />
                        </div>
                        <div class="form-field compact-field">
                            <label for="soluciono-realizacion">¿Solucionó el problema?</label>
                            <select id="soluciono-realizacion" @bind="solucionoProblemaRealizacion">
                                <option value="">No indicar</option>
                                <option value="True">Sí</option>
                                <option value="False">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="primary-button" @onclick="ConfirmRealizar">Confirmar realización</button>
                    </div>
                </div>
            }

            @if (CanVerify && selected.Estado == EstadoTarea.Realizada)
            {
                <div class="inline-confirm">
                    <h3>Verificar tarea</h3>
                    <label class="checkbox-item"><input type="checkbox" @bind="solucionoProblemaVerificacion" /> ¿Solucionó el problema?</label>
                    <div class="form-field compact-field">
                        <label for="fecha-comprobacion">Fecha de comprobación</label>
                        <InputDate id="fecha-comprobacion" @bind-Value="fechaComprobacion" />
                    </div>
                    <div class="form-actions">
                        <button class="primary-button" @onclick="Verify">Verificar</button>
                    </div>
                </div>
            }

            @if (CanAnular && selected.Estado != EstadoTarea.Anulada)
            {
                <div class="inline-confirm">
                    <h3>Anular tarea</h3>
                    <input @bind="motivoAnulacion" placeholder="Motivo de anulación" />
                    <div class="form-actions">
                        <button class="destructive" @onclick="Anular">Confirmar anulación</button>
                    </div>
                </div>
            }
        </section>
    }
</RoleGuard>

@code {
    private IReadOnlyList<TareaDto> tareas = [];
    private IReadOnlyList<TipoTareaDto> tiposTarea = [];
    private IReadOnlyList<CampanaDto> campanas = [];
    private IReadOnlyList<EventoDto> eventos = [];
    private IReadOnlyList<InsumoDto> insumos = [];
    private IReadOnlyList<MaquinariaDto> maquinarias = [];
    private IReadOnlyList<UsuarioDto> usuarios = [];
    private IReadOnlyList<ContratistaDto> contratistas = [];
    private TareaFormModel model = NewModel();
    private TareaDto? selected;
    private string? formError;
    private string? pageError;
    private bool formOpen;
    private bool cargando;
    private string search = string.Empty;
    private string filterEstado = string.Empty;

    private string executorKey = string.Empty;
    private TipoRecursoTarea recursoTipo = TipoRecursoTarea.Insumo;
    private Guid recursoId = Guid.Empty;
    private decimal recursoCantidad = 1;
    private readonly List<RecursoUtilizadoDto> recursosPendientes = [];

    private string resultado = string.Empty;
    private DateTime? fechaRealizacion;
    private bool? solucionoProblemaRealizacion;
    private bool solucionoProblemaVerificacion = true;
    private DateTime? fechaComprobacion;
    private string motivoAnulacion = string.Empty;

    private UserRole? CurrentRole => Auth.CurrentUser?.Role;
    private bool CanCreate => CurrentRole is { } role && Permissions.CanCreateTarea(role);
    private bool CanAssign => CurrentRole is { } role && Permissions.CanAssignTarea(role);
    private bool CanExecute => CurrentRole is { } role && Permissions.CanExecuteTarea(role);
    private bool CanVerify => CurrentRole is { } role && Permissions.CanVerifyTarea(role);
    private bool CanAnular => CurrentRole is { } role && Permissions.CanAnularTarea(role);

    private IEnumerable<TareaDto> Filtered => tareas.Where(tarea =>
        (string.IsNullOrWhiteSpace(search) ||
         (tarea.Descripcion?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
         ContextoTexto(tarea.CampanaPotreroId).Contains(search, StringComparison.OrdinalIgnoreCase) ||
         ExecutorName(tarea).Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filterEstado) || tarea.Estado.ToString() == filterEstado));

    private IEnumerable<EventoDto> EventosDisponibles => model.CampanaPotreroId == Guid.Empty
        ? []
        : eventos.Where(evento =>
            evento.CampanaPotreroId == model.CampanaPotreroId &&
            evento.Estado == EstadoEvento.Registrado);

    private IEnumerable<InsumoDto> InsumosDisponibles => selected is null
        ? []
        : insumos.Where(item => item.EmpresaId == selected.EmpresaId && item.Activo);

    private IEnumerable<MaquinariaDto> MaquinariaDisponible => selected is null
        ? []
        : maquinarias.Where(item => item.EmpresaId == selected.EmpresaId && item.Activo);

    private IEnumerable<(Guid Id, string Nombre)> RecursosDisponibles => recursoTipo == TipoRecursoTarea.Insumo
        ? InsumosDisponibles.Select(item => (item.Id, item.Nombre))
        : MaquinariaDisponible.Select(item => (item.Id, item.Nombre));

    private IEnumerable<(string Key, string Label)> ExecutorOptions
    {
        get
        {
            if (selected is null)
            {
                return [];
            }

            var options = new List<(string, string)>();
            options.AddRange(usuarios
                .Where(usuario => usuario.Rol == RolApi.OperarioCampo &&
                                  usuario.Activo &&
                                  usuario.EmpresaId == selected.EmpresaId)
                .Select(usuario => ($"{TipoEjecutorTarea.Usuario}:{usuario.Id}", $"Operario · {usuario.Nombre}")));
            options.AddRange(contratistas
                .Where(contratista => contratista.EmpresaId == selected.EmpresaId && contratista.Activo)
                .Select(contratista => ($"{TipoEjecutorTarea.Contratista}:{contratista.Id}", $"Contratista · {contratista.Nombre}")));
            return options;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            tareas = await TareaService.GetAllAsync(incluirAnuladas: true);
            tiposTarea = await TipoTareaService.GetAllAsync(incluirInactivos: true);
            campanas = await CampanaService.GetAllAsync(incluirAnuladas: false);
            eventos = await EventoService.GetAllAsync(incluirAnulados: false);
            insumos = await InsumoService.GetAllAsync(incluirInactivos: true);
            maquinarias = await MaquinariaService.GetAllAsync(incluirInactivos: true);
            usuarios = await UserService.GetAllAsync(incluirInactivos: false);
            contratistas = await ContratistaService.GetAllAsync(incluirInactivos: false);

            if (selected is not null)
            {
                selected = tareas.FirstOrDefault(tarea => tarea.Id == selected.Id);
            }
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Tareas &&
            modulo != ModulosDatos.Eventos &&
            modulo != ModulosDatos.Insumos &&
            modulo != ModulosDatos.Maquinaria &&
            modulo != ModulosDatos.Contratistas &&
            modulo != ModulosDatos.Usuarios &&
            modulo != ModulosDatos.Campanas &&
            modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void NewTarea()
    {
        model = NewModel();
        formError = null;
        formOpen = true;
    }

    private void EditTarea(Guid id)
    {
        var tarea = tareas.FirstOrDefault(candidato => candidato.Id == id);
        if (tarea is null)
        {
            return;
        }

        model = new TareaFormModel
        {
            Id = tarea.Id,
            CampanaPotreroId = tarea.CampanaPotreroId,
            EventoId = tarea.EventoId,
            TipoTareaId = tarea.TipoTareaId,
            Descripcion = tarea.Descripcion ?? string.Empty,
            FechaPlanificada = tarea.FechaPlanificada ?? SigaTime.TodayLocal,
            Version = tarea.Version
        };
        formError = null;
        formOpen = true;
    }

    private void Cancel()
    {
        formOpen = false;
        model = NewModel();
        formError = null;
    }

    private async Task Save()
    {
        formError = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                await TareaService.CreateAsync(new CrearTareaDto
                {
                    EmpresaId = Contexto.EmpresaActivaId,
                    CampanaPotreroId = model.CampanaPotreroId,
                    EventoId = model.EventoId,
                    TipoTareaId = model.TipoTareaId,
                    Descripcion = model.Descripcion.Trim(),
                    FechaPlanificada = model.FechaPlanificada.Date
                });
            }
            else
            {
                var actualizada = await TareaService.UpdateAsync(new ActualizarTareaDto
                {
                    Id = model.Id,
                    TipoTareaId = model.TipoTareaId,
                    Descripcion = model.Descripcion.Trim(),
                    FechaPlanificada = model.FechaPlanificada.Date,
                    Version = model.Version
                });

                if (actualizada is null)
                {
                    throw new InvalidOperationException("No se encontró la tarea.");
                }
            }

            Cancel();
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void SelectTask(Guid id)
    {
        selected = tareas.FirstOrDefault(tarea => tarea.Id == id);
        pageError = null;
        executorKey = string.Empty;
        recursoId = Guid.Empty;
        recursoCantidad = 1;
        recursosPendientes.Clear();
        resultado = selected?.Resultado ?? string.Empty;
        fechaRealizacion = null;
        solucionoProblemaRealizacion = selected?.SolucionoProblema;
        solucionoProblemaVerificacion = selected?.SolucionoProblema ?? true;
        fechaComprobacion = null;
        motivoAnulacion = string.Empty;
    }

    private async Task RecargarSeleccionAsync()
    {
        if (selected is null)
        {
            return;
        }

        var id = selected.Id;
        await LoadAsync();
        selected = tareas.FirstOrDefault(tarea => tarea.Id == id);
    }

    private async Task AssignSelected()
    {
        if (selected is null)
        {
            return;
        }

        pageError = null;

        try
        {
            var parts = executorKey.Split(':');
            if (parts.Length != 2 ||
                !Enum.TryParse<TipoEjecutorTarea>(parts[0], out var tipo) ||
                !Guid.TryParse(parts[1], out var executorId))
            {
                throw new InvalidOperationException("Seleccioná un ejecutor válido.");
            }

            await TareaService.AssignAsync(selected.Id, executorId, tipo, selected.Version);
            await RecargarSeleccionAsync();
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private string RecursoNombre(RecursoUtilizadoDto recurso) =>
        recurso.Tipo == TipoRecursoTarea.Insumo
            ? insumos.FirstOrDefault(item => item.Id == recurso.RecursoId)?.Nombre ?? "Insumo"
            : maquinarias.FirstOrDefault(item => item.Id == recurso.RecursoId)?.Nombre ?? "Maquinaria";

    private void AddResource()
    {
        if (selected is null)
        {
            return;
        }

        pageError = null;

        try
        {
            if (recursoId == Guid.Empty)
            {
                throw new InvalidOperationException("Seleccioná un recurso.");
            }

            if (recursoCantidad <= 0)
            {
                throw new InvalidOperationException("La cantidad debe ser mayor que cero.");
            }

            var existente = recursosPendientes.FirstOrDefault(
                recurso => recurso.Tipo == recursoTipo && recurso.RecursoId == recursoId);

            if (existente is not null)
            {
                existente.Cantidad += recursoCantidad;
            }
            else
            {
                recursosPendientes.Add(new RecursoUtilizadoDto
                {
                    Tipo = recursoTipo,
                    RecursoId = recursoId,
                    Cantidad = recursoCantidad
                });
            }

            recursoId = Guid.Empty;
            recursoCantidad = 1;
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void RemovePending(RecursoUtilizadoDto recurso) =>
        recursosPendientes.Remove(recurso);

    private async Task ConfirmRealizar()
    {
        if (selected is null)
        {
            return;
        }

        pageError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(resultado))
            {
                throw new InvalidOperationException("Ingresá el resultado de la tarea.");
            }

            await TareaService.RealizarAsync(selected.Id, new RealizarTareaDto
            {
                Resultado = resultado.Trim(),
                FechaRealizacion = fechaRealizacion?.Date,
                SolucionoProblema = solucionoProblemaRealizacion,
                Recursos = recursosPendientes.ToList(),
                Version = selected.Version
            });

            recursosPendientes.Clear();
            await RecargarSeleccionAsync();
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private async Task Verify()
    {
        if (selected is null)
        {
            return;
        }

        pageError = null;

        try
        {
            await TareaService.VerifyAsync(selected.Id, new VerificarTareaDto
            {
                SolucionoProblema = solucionoProblemaVerificacion,
                FechaComprobacion = fechaComprobacion?.Date,
                Version = selected.Version
            });

            await RecargarSeleccionAsync();
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private async Task Anular()
    {
        if (selected is null)
        {
            return;
        }

        pageError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(motivoAnulacion))
            {
                throw new InvalidOperationException("Ingresá el motivo de anulación.");
            }

            await TareaService.AnularAsync(selected.Id, new AnularTareaDto
            {
                MotivoAnulacion = motivoAnulacion.Trim(),
                Version = selected.Version
            });

            motivoAnulacion = string.Empty;
            await RecargarSeleccionAsync();
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private static string ExecutorName(TareaDto tarea) =>
        tarea.EjecutorId is null ? "Sin asignar" : tarea.EjecutorNombre ?? "—";

    private string ContextoTexto(Guid assignmentId)
    {
        foreach (var campana in campanas)
        {
            var potrero = campana.Potreros.FirstOrDefault(item => item.Id == assignmentId);
            if (potrero is not null)
            {
                return $"{campana.Nombre} · {potrero.PotreroNombre}";
            }
        }

        return "—";
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;

    private static TareaFormModel NewModel() => new() { FechaPlanificada = SigaTime.TodayLocal };

    private sealed class TareaFormModel
    {
        public Guid Id { get; set; }
        public Guid CampanaPotreroId { get; set; }
        public Guid? EventoId { get; set; }
        public Guid TipoTareaId { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La descripción es obligatoria.")]
        public string Descripcion { get; set; } = string.Empty;

        public DateTime FechaPlanificada { get; set; }
        public long Version { get; set; }
    }
}
