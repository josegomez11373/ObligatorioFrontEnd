@page "/tareas"
@implements IDisposable
@inject TareaService TareaService
@inject TipoTareaService TipoTareaService
@inject CampanaService CampanaService
@inject PotreroService PotreroService
@inject EventoService EventoService
@inject IAuthService Auth
@inject UserService UserService
@inject ContratistaService ContratistaService
@inject InsumoService InsumoService
@inject MaquinariaService MaquinariaService
@using MaquinariaModel = ObligatorioFrontEnd.Models.Maquinaria

<PageTitle>Tareas | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Tareas">
    <section class="page-header">
        <div>
            <p class="eyebrow">Ejecución agrícola</p>
            <h1>Tareas</h1>
            <p class="page-intro">Planificá acciones sobre una campaña, asigná responsables y registrá costos, resultados y verificación.</p>
        </div>
        @if (CanCreate)
        {
            <button class="primary-button primary-button--inline" @onclick="NewTarea">Nueva tarea</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <p class="form-error" role="alert">@pageError</p>
    }

    <section class="card">
            <h2>Tareas</h2>

            <div class="filter-row">
                <div class="form-field compact-field">
                    <label for="buscar-tarea">Buscar</label>
                    <input id="buscar-tarea" @bind="search" @bind:event="oninput" placeholder="Descripción, potrero o ejecutor" />
                </div>
                <div class="form-field compact-field">
                    <label for="filtro-estado-tarea">Estado</label>
                    <select id="filtro-estado-tarea" @bind="filterEstado">
                        <option value="">Todos</option>
                        @foreach (var estado in Enum.GetValues<TareaEstado>())
                        {
                            <option value="@estado">@estado</option>
                        }
                    </select>
                </div>
            </div>

            @if (!Filtered.Any())
            {
                <p class="muted">No hay tareas que coincidan con los filtros.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Tipo</th><th>Descripción</th><th>Campaña / potrero</th><th>Fecha</th><th>Ejecutor</th><th>Recursos</th><th>Costo</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var tarea in Filtered)
                        {
                            <tr class="@(tarea.Estado == TareaEstado.Anulada ? "row-muted" : null)">
                                <td>@(TipoTareaService.GetById(tarea.TipoTareaId)?.Nombre ?? "—")</td>
                                <td>@tarea.Descripcion</td>
                                <td>@Contexto(tarea.CampanaPotreroId)</td>
                                <td>@tarea.FechaPlanificada.ToString("dd/MM/yyyy")</td>
                                <td>@ExecutorName(tarea)</td>
                                <td>@tarea.Recursos.Count</td>
                                <td>@((tarea.Costo ?? 0).ToString("C"))</td>
                                <td>@tarea.Estado</td>
                                <td class="actions">
                                    <button @onclick="() => SelectTask(tarea.Id)">Detalle</button>
                                    @if (CanCreate && tarea.Estado is TareaEstado.Planificada or TareaEstado.Asignada)
                                    {
                                        <button @onclick="() => EditTarea(tarea.Id)">Editar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanCreate)
    {
        <SidePanel IsOpen="formOpen" Title="@(model.Id == Guid.Empty ? "Crear tarea" : "Editar tarea")" OnClose="Cancel">
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-field">
                        <label for="tarea-campana">Campaña y potrero</label>
                        <InputSelect id="tarea-campana" @bind-Value="model.CampanaPotreroId">
                            <option value="@Guid.Empty">Seleccioná una campaña y potrero...</option>
                            @foreach (var item in CampanaService.GetCampanaPotreros().Where(item => item.Campana.Estado is CampanaEstado.Planificada or CampanaEstado.Activa && item.Assignment.Estado is CampanaEstado.Planificada or CampanaEstado.Activa))
                            {
                                <option value="@item.Assignment.Id">@item.Campana.Nombre · @PotreroNombre(item.Assignment.PotreroId)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label for="tarea-tipo">Tipo de tarea</label>
                        <InputSelect id="tarea-tipo" @bind-Value="model.TipoTareaId">
                            <option value="@Guid.Empty">Seleccioná un tipo...</option>
                            @foreach (var tipo in TipoTareaService.GetAll())
                            {
                                <option value="@tipo.Id">@tipo.Nombre</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label for="tarea-evento">Evento que responde (opcional)</label>
                        <InputSelect id="tarea-evento" @bind-Value="model.EventoId">
                            <option value="">Sin evento asociado</option>
                            @foreach (var evento in EventosDisponibles)
                            {
                                <option value="@evento.Id">@evento.Fecha.ToString("dd/MM/yyyy") · @evento.Descripcion</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label for="tarea-descripcion">Descripción</label>
                        <InputTextArea id="tarea-descripcion" @bind-Value="model.Descripcion" rows="3" />
                    </div>

                    <div class="form-field">
                        <label for="tarea-fecha">Fecha planificada</label>
                        <InputDate id="tarea-fecha" @bind-Value="model.FechaPlanificada" />
                    </div>

                    <div class="form-actions">
                        <button class="primary-button" type="submit">Guardar tarea</button>
                        <button type="button" @onclick="Cancel">Cancelar</button>
                    </div>
                </EditForm>
                @if (!string.IsNullOrWhiteSpace(formError))
                {
                    <p class="form-error" role="alert">@formError</p>
                }
        </SidePanel>
    }

    @if (selected is not null)
    {
        <section class="card">
            <div class="card-header">
                <div>
                    <h2>@selected.Descripcion</h2>
                    <p class="muted">@(TipoTareaService.GetById(selected.TipoTareaId)?.Nombre ?? "—") · @Contexto(selected.CampanaPotreroId) · @selected.FechaPlanificada.ToString("dd/MM/yyyy")</p>
                    <p class="muted">Estado: <strong>@selected.Estado</strong> · Ejecutor: @ExecutorName(selected) · Costo: @((selected.Costo ?? 0).ToString("C"))</p>
                    @if (selected.FechaRealizacion is DateTime realizada)
                    {
                        <p class="muted">Realizada: @SigaTime.Format(realizada)</p>
                    }
                    @if (selected.FechaComprobacion is DateTime verificada)
                    {
                        <p class="muted">Verificada: @SigaTime.Format(verificada) por @(selected.VerificadaPor ?? "—")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(selected.Resultado))
                    {
                        <p class="muted">Resultado: @selected.Resultado</p>
                    }
                    @if (selected.SolucionoProblema is bool soluciono)
                    {
                        <p class="muted">¿Solucionó el problema? @(soluciono ? "Sí" : "No")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(selected.MotivoAnulacion))
                    {
                        <p class="muted">Motivo de anulación: @selected.MotivoAnulacion</p>
                    }
                </div>
                <button @onclick="() => selected = null">Cerrar</button>
            </div>

            @if (selected.Recursos.Count > 0)
            {
                <h3>Recursos</h3>
                <table class="table">
                    <thead><tr><th>Tipo</th><th>Recurso</th><th>Cantidad</th><th>Costo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var recurso in selected.Recursos)
                        {
                            <tr>
                                <td>@recurso.Tipo</td>
                                <td>@ResourceName(recurso)</td>
                                <td>@recurso.Cantidad.ToString("G")</td>
                                <td>@((recurso.Costo ?? 0).ToString("C"))</td>
                                <td class="actions">
                                    @if (CanAssign && selected.Estado is not (TareaEstado.Verificada or TareaEstado.Anulada))
                                    {
                                        <button class="destructive" @onclick="() => RemoveResource(recurso.Id)">Quitar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (CanAssign && selected.Estado is not (TareaEstado.Verificada or TareaEstado.Anulada))
            {
                <div class="inline-confirm">
                    <h3>Asignación y costos</h3>
                    <div class="filter-row">
                        <div class="form-field compact-field">
                            <label for="ejecutor">Ejecutor</label>
                            <select id="ejecutor" @bind="executorKey">
                                <option value="">Seleccioná un ejecutor...</option>
                                @foreach (var option in ExecutorOptions)
                                {
                                    <option value="@option.Key">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div class="form-field compact-field">
                            <label for="costo-contratista">Costo del contratista</label>
                            <input id="costo-contratista" type="number" min="0" step="0.01" @bind="costoContratista" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="AssignSelected">Asignar ejecutor</button>
                        <button @onclick="SaveCostoContratista">Guardar costo del contratista</button>
                    </div>
                </div>

                <div class="inline-confirm">
                    <h3>Agregar recurso</h3>
                    <div class="filter-row">
                        <div class="form-field compact-field">
                            <label for="recurso-tipo">Tipo</label>
                            <select id="recurso-tipo" @bind="recursoTipo">
                                <option value="@TareaRecursoTipo.Insumo">Insumo</option>
                                <option value="@TareaRecursoTipo.Maquinaria">Maquinaria</option>
                            </select>
                        </div>
                        <div class="form-field compact-field">
                            <label for="recurso">Recurso</label>
                            <select id="recurso" @bind="recursoId">
                                <option value="@Guid.Empty">Seleccioná...</option>
                                @foreach (var recurso in RecursosDisponibles)
                                {
                                    <option value="@recurso.Id">@recurso.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="form-field compact-field">
                            <label for="recurso-cantidad">Cantidad</label>
                            <input id="recurso-cantidad" type="number" min="0.01" step="0.01" @bind="recursoCantidad" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="AddResource">Agregar recurso</button>
                    </div>
                </div>
            }

            @if (CanExecute && selected.Estado is TareaEstado.Planificada or TareaEstado.Asignada)
            {
                <div class="form-actions">
                    <button class="primary-button" @onclick="MarcarRealizada">Marcar como realizada</button>
                </div>
            }

            @if (CanRegisterResult && selected.Estado is not (TareaEstado.Verificada or TareaEstado.Anulada))
            {
                <div class="inline-confirm">
                    <h3>Registrar resultado</h3>
                    <textarea @bind="resultado" rows="2" placeholder="Resultado de la tarea"></textarea>
                    <div class="form-actions">
                        <button @onclick="RegisterResult">Guardar resultado</button>
                    </div>
                </div>
            }

            @if (CanVerify && selected.Estado == TareaEstado.Realizada)
            {
                <div class="inline-confirm">
                    <h3>Verificar tarea</h3>
                    <label class="checkbox-item"><input type="checkbox" @bind="solucionoProblema" /> ¿Solucionó el problema?</label>
                    <textarea @bind="comentarioVerificacion" rows="2" placeholder="Comentario de verificación (opcional)"></textarea>
                    <div class="form-actions">
                        <button class="primary-button" @onclick="Verify">Verificar</button>
                    </div>
                </div>
            }

            @if (CanAnular && selected.Estado != TareaEstado.Anulada)
            {
                <div class="inline-confirm">
                    <h3>Anular tarea</h3>
                    <input @bind="motivoAnulacion" placeholder="Motivo de anulación" />
                    <div class="form-actions">
                        <button class="destructive" @onclick="Anular">Confirmar anulación</button>
                    </div>
                </div>
            }
        </section>
    }
</RoleGuard>

@code {
    private IReadOnlyList<Tarea> tareas = [];
    private TareaEditModel model = new();
    private Tarea? selected;
    private string? formError;
    private string? pageError;
    private bool formOpen;
    private string search = string.Empty;
    private string filterEstado = string.Empty;

    private string executorKey = string.Empty;
    private decimal? costoContratista;
    private TareaRecursoTipo recursoTipo = TareaRecursoTipo.Insumo;
    private Guid recursoId = Guid.Empty;
    private decimal recursoCantidad = 1;

    private string resultado = string.Empty;
    private bool solucionoProblema = true;
    private string? comentarioVerificacion;
    private string motivoAnulacion = string.Empty;

    private UserRole? CurrentRole => Auth.CurrentUser?.Role;
    private bool CanCreate => CurrentRole is { } role && Permissions.CanCreateTarea(role);
    private bool CanAssign => CurrentRole is { } role && Permissions.CanAssignTarea(role);
    private bool CanExecute => CurrentRole is { } role && Permissions.CanExecuteTarea(role);
    private bool CanRegisterResult => CurrentRole is { } role && Permissions.CanRegisterResult(role);
    private bool CanVerify => CurrentRole is { } role && Permissions.CanVerifyTarea(role);
    private bool CanAnular => CurrentRole is { } role && Permissions.CanAnularTarea(role);

    private IEnumerable<Tarea> Filtered => tareas.Where(tarea =>
        (string.IsNullOrWhiteSpace(search) ||
         tarea.Descripcion.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         Contexto(tarea.CampanaPotreroId).Contains(search, StringComparison.OrdinalIgnoreCase) ||
         ExecutorName(tarea).Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filterEstado) || tarea.Estado.ToString() == filterEstado));

    private IEnumerable<Evento> EventosDisponibles => model.CampanaPotreroId == Guid.Empty
        ? []
        : EventoService.GetAll(includeAnulados: false).Where(evento => evento.CampanaPotreroId == model.CampanaPotreroId);

    private IEnumerable<Insumo> InsumosDisponibles => selected is null ? [] : InsumoService.GetAll().Where(item => item.EmpresaId == selected.EmpresaId);
    private IEnumerable<MaquinariaModel> MaquinariaDisponible => selected is null ? [] : MaquinariaService.GetAll().Where(item => item.EmpresaId == selected.EmpresaId);

    private IEnumerable<(Guid Id, string Nombre)> RecursosDisponibles => recursoTipo == TareaRecursoTipo.Insumo
        ? InsumosDisponibles.Select(item => (item.Id, item.Nombre))
        : MaquinariaDisponible.Select(item => (item.Id, item.Nombre));

    private IEnumerable<(string Key, string Label)> ExecutorOptions
    {
        get
        {
            if (selected is null) return [];

            var options = new List<(string, string)>();
            options.AddRange(UserService.GetAll()
                .Where(user => user.Rol == UserRole.OperarioCampo && user.EmpresaId == selected.EmpresaId)
                .Select(user => ($"{TareaEjecutorTipo.Usuario}:{user.Id}", $"Operario · {user.Nombre}")));
            options.AddRange(ContratistaService.GetAll()
                .Where(contractor => contractor.EmpresaId == selected.EmpresaId)
                .Select(contractor => ($"{TareaEjecutorTipo.Contratista}:{contractor.Id}", $"Contratista · {contractor.Nombre}")));
            return options;
        }
    }

    protected override void OnInitialized()
    {
        TareaService.StateChanged += Load;
        Load();
    }

    private void Load()
    {
        tareas = TareaService.GetAll();
        if (selected is not null)
        {
            selected = TareaService.GetById(selected.Id);
        }

        InvokeAsync(StateHasChanged);
    }

    private void NewTarea()
    {
        model = new TareaEditModel { FechaPlanificada = SigaTime.TodayLocal };
        formError = null;
        formOpen = true;
    }

    private void EditTarea(Guid id)
    {
        var tarea = TareaService.GetById(id);
        if (tarea is null) return;

        model = new TareaEditModel
        {
            Id = tarea.Id,
            CampanaPotreroId = tarea.CampanaPotreroId,
            EventoId = tarea.EventoId,
            TipoTareaId = tarea.TipoTareaId,
            Descripcion = tarea.Descripcion,
            FechaPlanificada = tarea.FechaPlanificada,
            Estado = tarea.Estado,
            Version = tarea.Version
        };
        formError = null;
        formOpen = true;
    }

    private void Cancel()
    {
        formOpen = false;
        model = new TareaEditModel { FechaPlanificada = SigaTime.TodayLocal };
        formError = null;
    }

    private void Save()
    {
        formError = null;
        try
        {
            var assignment = CampanaService.GetCampanaPotreroById(model.CampanaPotreroId)
                ?? throw new InvalidOperationException("Debe seleccionar una campaña y potrero.");

            var draft = new Tarea
            {
                Id = model.Id,
                EmpresaId = assignment.Campana.EmpresaId,
                CampanaPotreroId = model.CampanaPotreroId,
                EventoId = model.EventoId,
                TipoTareaId = model.TipoTareaId,
                Descripcion = model.Descripcion.Trim(),
                FechaPlanificada = model.FechaPlanificada.Date
            };

            if (model.Id == Guid.Empty)
            {
                TareaService.Create(draft);
            }
            else
            {
                TareaService.Update(draft, model.Version);
            }

            Cancel();
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void SelectTask(Guid id)
    {
        selected = TareaService.GetById(id);
        pageError = null;
        executorKey = string.Empty;
        costoContratista = selected?.CostoContratista;
        recursoId = Guid.Empty;
        recursoCantidad = 1;
        resultado = selected?.Resultado ?? string.Empty;
        motivoAnulacion = string.Empty;
        comentarioVerificacion = null;
    }

    private void AssignSelected()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            var parts = executorKey.Split(':');
            if (parts.Length != 2 || !Enum.TryParse<TareaEjecutorTipo>(parts[0], out var tipo) || !Guid.TryParse(parts[1], out var executorId))
            {
                throw new InvalidOperationException("Seleccione un ejecutor válido.");
            }

            TareaService.Assign(selected.Id, executorId, tipo);
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void SaveCostoContratista()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            TareaService.SetCostoContratista(selected.Id, costoContratista ?? 0);
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void AddResource()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            if (recursoId == Guid.Empty)
            {
                throw new InvalidOperationException("Seleccione un recurso.");
            }

            TareaService.AddResource(selected.Id, new TareaRecurso
            {
                Tipo = recursoTipo,
                RecursoId = recursoId,
                Cantidad = recursoCantidad
            });
            recursoId = Guid.Empty;
            recursoCantidad = 1;
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void RemoveResource(Guid resourceId)
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            TareaService.RemoveResource(selected.Id, resourceId);
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void MarcarRealizada()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            TareaService.MarcarRealizada(selected.Id);
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void RegisterResult()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            TareaService.RegisterResult(selected.Id, resultado);
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void Verify()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            TareaService.Verify(selected.Id, solucionoProblema, comentarioVerificacion);
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void Anular()
    {
        if (selected is null) return;
        pageError = null;
        try
        {
            TareaService.Anular(selected.Id, motivoAnulacion);
            motivoAnulacion = string.Empty;
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private string ExecutorName(Tarea tarea)
    {
        if (tarea.EjecutorId is not Guid id) return "Sin asignar";
        return tarea.EjecutorTipo == TareaEjecutorTipo.Contratista
            ? ContratistaService.GetById(id)?.Nombre ?? "Contratista"
            : UserService.GetById(id)?.Nombre ?? "Usuario";
    }

    private string ResourceName(TareaRecurso resource) => resource.Tipo == TareaRecursoTipo.Insumo
        ? InsumoService.GetById(resource.RecursoId)?.Nombre ?? "Insumo"
        : MaquinariaService.GetById(resource.RecursoId)?.Nombre ?? "Maquinaria";

    private string Contexto(Guid assignmentId)
    {
        var assignment = CampanaService.GetCampanaPotreroById(assignmentId);
        return assignment is null
            ? "—"
            : $"{assignment.Value.Campana.Nombre} · {PotreroNombre(assignment.Value.Assignment.PotreroId)}";
    }

    private string PotreroNombre(Guid potreroId) => PotreroService.GetById(potreroId)?.Nombre ?? "Potrero no disponible";

    public void Dispose() => TareaService.StateChanged -= Load;
}
