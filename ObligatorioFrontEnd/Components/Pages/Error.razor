@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Identificador de solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error.
</p>
<p>
    <strong>El entorno de desarrollo no debe habilitarse en aplicaciones publicadas.</strong>
    Podría mostrar información sensible de las excepciones a los usuarios finales.
    Para depuración local, establecé la variable <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong>
    y reiniciá la aplicación.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
