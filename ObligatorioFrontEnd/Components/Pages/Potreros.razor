@page "/potreros"
@page "/potreros/{editId:guid}"
@implements IDisposable
@inject IServicioPotreros PotreroService
@inject IServicioEstablecimientos EstablecimientoService
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject NavigationManager Navigation
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Potreros | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Potreros">
    <section class="page-header">
        <div>
            <p class="eyebrow">Estructura agrícola</p>
            <h1>Potreros</h1>
            <p class="page-intro">Crear y consultar potreros de un establecimiento; la desactivación conserva historial.</p>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewPotrero">Nuevo potrero</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
        <h2>Potreros (@(potreros?.Count ?? 0))</h2>
        @if (cargando && potreros is null)
        {
            <p>Cargando...</p>
        }
        else if (potreros is null || !potreros.Any())
        {
            <p class="muted">No hay potreros registrados para la empresa activa.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Establecimiento</th><th>Nombre</th><th>Superficie (ha)</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var potrero in potreros)
                    {
                        <tr class="@(potrero.Activo ? null : "row-muted")">
                            <td>@potrero.EstablecimientoNombre</td>
                            <td>@potrero.Nombre</td>
                            <td>@(potrero.SuperficieHa?.ToString("G") ?? "—")</td>
                            <td>@(potrero.Activo ? "Activo" : "Desactivado")</td>
                            <td class="actions">
                                @if (CanManage)
                                {
                                    <button type="button" @onclick="() => EditPotrero(potrero.Id)">Editar</button>
                                    @if (potrero.Activo)
                                    {
                                        <button type="button" class="destructive" @onclick="() => Deactivate(potrero.Id)">Desactivar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Crear potrero" : "Editar potrero")" OnClose="Cancel">
            <PotreroForm Model="editModel" Establecimientos="EstablecimientosForm" OnValidSubmit="HandleFormSubmit" OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<PotreroDto>? potreros;
    private IReadOnlyList<EstablecimientoDto> establecimientos = [];
    private PotreroEditModel editModel = new();
    private string? formError;
    private string? error;
    private bool formOpen;
    private bool cargando;
    private Guid? loadedEditId;

    [Parameter]
    public Guid? editId { get; set; }

    private bool CanManage => Auth.CanManage(SigaModule.Potreros);

    private IReadOnlyList<EstablecimientoDto> EstablecimientosForm => establecimientos;

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadEditAsync();
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            var potrerosTask = PotreroService.GetAllAsync(incluirInactivos: true);
            var establecimientosTask = EstablecimientoService.GetAllAsync(incluirInactivos: true);
            await Task.WhenAll(potrerosTask, establecimientosTask);

            var activa = Contexto.EmpresaActivaId;
            var listaEstablecimientos = await establecimientosTask;
            establecimientos = activa is Guid empresaId
                ? listaEstablecimientos.Where(establecimiento => establecimiento.EmpresaId == empresaId).ToList()
                : listaEstablecimientos;

            var listaPotreros = await potrerosTask;
            potreros = activa is Guid empresaPotrero
                ? listaPotreros.Where(potrero => potrero.EmpresaId == empresaPotrero).ToList()
                : listaPotreros;
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LoadEditAsync()
    {
        if (editId is not Guid id)
        {
            if (formOpen && editModel.Id == Guid.Empty)
            {
                return;
            }

            loadedEditId = null;
            formOpen = false;
            return;
        }

        if (loadedEditId == id && formOpen)
        {
            return;
        }

        loadedEditId = id;
        formOpen = true;
        formError = null;

        try
        {
            var potrero = await PotreroService.GetByIdAsync(id);
            if (potrero is null)
            {
                editModel = NewModel();
                formError = "No se encontró el potrero solicitado.";
                return;
            }

            editModel = new PotreroEditModel
            {
                Id = potrero.Id,
                EstablecimientoId = potrero.EstablecimientoId,
                Nombre = potrero.Nombre,
                SuperficieHa = potrero.SuperficieHa,
                Limites = potrero.Limites,
                Activo = potrero.Activo,
                Version = potrero.Version
            };
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Potreros &&
            modulo != ModulosDatos.Establecimientos &&
            modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            await LoadEditAsync();
            StateHasChanged();
        });
    }

    private void NewPotrero()
    {
        editModel = NewModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/potreros", replace: true);
    }

    private void EditPotrero(Guid id) => Navigation.NavigateTo($"/potreros/{id}");

    private void Cancel()
    {
        formOpen = false;
        editModel = NewModel();
        formError = null;
        error = null;
        Navigation.NavigateTo("/potreros", replace: true);
    }

    private async Task HandleFormSubmit(PotreroEditModel model)
    {
        formError = null;
        error = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                await PotreroService.CreateAsync(new CrearPotreroDto
                {
                    EstablecimientoId = model.EstablecimientoId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Limites = model.Limites?.Trim()
                });
            }
            else
            {
                var actualizado = await PotreroService.UpdateAsync(new ActualizarPotreroDto
                {
                    Id = model.Id,
                    EstablecimientoId = model.EstablecimientoId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Limites = model.Limites?.Trim(),
                    Activo = model.Activo,
                    Version = model.Version
                });

                if (actualizado is null)
                {
                    formError = "No se encontró el potrero.";
                    return;
                }
            }

            Cancel();
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private async Task Deactivate(Guid id)
    {
        error = null;

        try
        {
            await PotreroService.DeactivateAsync(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private PotreroEditModel NewModel() => new()
    {
        EstablecimientoId = establecimientos.FirstOrDefault(establecimiento => establecimiento.Activo)?.Id ?? Guid.Empty
    };

    public void Dispose() => Notificador.Cambio -= HandleChanged;
}
