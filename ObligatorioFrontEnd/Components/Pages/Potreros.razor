@page "/potreros"
@page "/potreros/{editId:guid}"
@implements IDisposable
@inject PotreroService PotreroService
@inject EstablecimientoService EstablecimientoService
@inject NavigationManager Navigation
@inject DemoAuthService Auth

@using ObligatorioFrontEnd.Models

<PageTitle>Potreros | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Potreros">
    <section class="page-header">
        <div>
            <p class="eyebrow">Estructura agrícola</p>
            <h1>Potreros</h1>
            <p class="page-intro">Crear y consultar potreros de un establecimiento; la desactivación conserva historial.</p>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewPotrero">Nuevo potrero</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
            <h2>Potreros (@(potreros?.Count ?? 0))</h2>
            @if (potreros is null)
            {
                <p>Cargando...</p>
            }
            else if (!potreros.Any())
            {
                <p class="muted">No hay potreros registrados.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Establecimiento</th><th>Nombre</th><th>Superficie (ha)</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var potrero in potreros)
                        {
                            <tr class="@(potrero.Activo ? null : "row-muted")">
                                <td>@(EstablecimientoService.GetById(potrero.EstablecimientoId)?.Nombre ?? "—")</td>
                                <td>@potrero.Nombre</td>
                                <td>@(potrero.SuperficieHa?.ToString("G") ?? "—")</td>
                                <td>@(potrero.Activo ? "Activo" : "Desactivado")</td>
                                <td class="actions">
                                    @if (CanManage)
                                    {
                                        <button type="button" @onclick="() => EditPotrero(potrero.Id)">Editar</button>
                                        @if (potrero.Activo)
                                        {
                                            <button type="button" class="destructive" @onclick="() => Deactivate(potrero.Id)">Desactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Crear potrero" : "Editar potrero")" OnClose="Cancel">
            <PotreroForm Model="editModel" OnValidSubmit="HandleFormSubmit" OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<Potrero>? potreros;
    private PotreroEditModel editModel = new();
    private string? formError;
    private string? error;
    private bool formOpen;

    [Parameter]
    public Guid? editId { get; set; }

    private bool CanManage => Auth.CanManage(SigaModule.Potreros);

    protected override void OnInitialized()
    {
        PotreroService.StateChanged += HandleChanged;
        Load();
    }

    protected override void OnParametersSet()
    {
        formOpen = editId is not null;
        if (editId is not null)
        {
            var potrero = PotreroService.GetById(editId.Value);
            if (potrero is not null)
            {
                editModel = new PotreroEditModel
                {
                    Id = potrero.Id,
                    EstablecimientoId = potrero.EstablecimientoId,
                    Nombre = potrero.Nombre,
                    SuperficieHa = potrero.SuperficieHa,
                    Limites = potrero.Limites,
                    Activo = potrero.Activo,
                    Version = potrero.Version
                };
            }
            else
            {
                formError = "No se encontró el potrero solicitado.";
            }
        }
        else
        {
            editModel = NewModel();
            formError = null;
        }
    }

    private void Load()
    {
        potreros = PotreroService.GetAll();
        InvokeAsync(StateHasChanged);
    }

    private void HandleChanged() => Load();

    private void NewPotrero()
    {
        editModel = NewModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/potreros", replace: true);
    }

    private void EditPotrero(Guid id) => Navigation.NavigateTo($"/potreros/{id}");

    private void Cancel()
    {
        formOpen = false;
        editModel = NewModel();
        formError = null;
        error = null;
        Navigation.NavigateTo("/potreros", replace: true);
    }

    private void HandleFormSubmit(PotreroEditModel model)
    {
        formError = null;
        error = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                PotreroService.Create(new Potrero
                {
                    EstablecimientoId = model.EstablecimientoId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Limites = model.Limites?.Trim(),
                    Activo = model.Activo
                });
            }
            else
            {
                var updated = new Potrero
                {
                    Id = model.Id,
                    EstablecimientoId = model.EstablecimientoId,
                    Nombre = model.Nombre.Trim(),
                    SuperficieHa = model.SuperficieHa,
                    Limites = model.Limites?.Trim(),
                    Activo = model.Activo
                };

                if (!PotreroService.Update(updated, model.Version))
                {
                    formError = "No se encontró el potrero.";
                    return;
                }
            }

            editModel = NewModel();
            formOpen = false;
            Navigation.NavigateTo("/potreros", replace: true);
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void Deactivate(Guid id)
    {
        error = null;

        try
        {
            PotreroService.Deactivate(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    private PotreroEditModel NewModel() => new()
    {
        EstablecimientoId = EstablecimientoService.GetAll().FirstOrDefault()?.Id ?? Guid.Empty
    };

    public void Dispose() => PotreroService.StateChanged -= HandleChanged;
}
