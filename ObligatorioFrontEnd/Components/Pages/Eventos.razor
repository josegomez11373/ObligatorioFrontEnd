@page "/eventos"
@page "/eventos/{editId:guid}"
@implements IDisposable
@inject IServicioEventos EventoService
@inject IServicioFotografias FotografiaService
@inject IServicioTiposEvento TipoEventoService
@inject IServicioCampanas CampanaService
@inject IContextoEmpresa Contexto
@inject NotificadorDatos Notificador
@inject IAuthService Auth
@inject NavigationManager Navigation

@using ObligatorioFrontEnd.Api.Contratos
@using ObligatorioFrontEnd.Models

<PageTitle>Eventos | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Eventos">
    <section class="page-header">
        <div>
            <p class="eyebrow">Registro de campo</p>
            <h1>Eventos</h1>
            <p class="page-intro">Registrá observaciones, ubicación y evidencia fotográfica de cada campaña.</p>
        </div>
        @if (Auth.CanManage(SigaModule.Eventos))
        {
            <button class="primary-button primary-button--inline" @onclick="NewEvento">Nuevo evento</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <p class="form-error" role="alert">@pageError</p>
    }

    <section class="card">
        <h2>Registro de eventos</h2>

        <div class="filter-row">
            <div class="form-field compact-field">
                <label for="buscar-evento">Buscar</label>
                <input id="buscar-evento" @bind="search" @bind:event="oninput" placeholder="Descripción, ubicación o autor" />
            </div>
            <div class="form-field compact-field">
                <label for="filtro-tipo-evento">Tipo</label>
                <select id="filtro-tipo-evento" @bind="filterTipo">
                    <option value="">Todos</option>
                    @foreach (var tipo in tiposEvento)
                    {
                        <option value="@tipo.Id">@tipo.Nombre</option>
                    }
                </select>
            </div>
            <div class="form-field compact-field">
                <label for="filtro-estado-evento">Estado</label>
                <select id="filtro-estado-evento" @bind="filterEstado">
                    <option value="">Todos</option>
                    <option value="@EstadoEvento.Registrado">Registrado</option>
                    <option value="@EstadoEvento.Anulado">Anulado</option>
                </select>
            </div>
        </div>

        @if (cargando && eventos.Count == 0)
        {
            <p>Cargando...</p>
        }
        else if (!Filtered.Any())
        {
            <p class="muted">No hay eventos que coincidan con los filtros.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Fecha</th><th>Tipo</th><th>Campaña / potrero</th><th>Autor</th><th>Fotos</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var evento in Filtered)
                    {
                        <tr class="@(evento.Estado == EstadoEvento.Anulado ? "row-muted" : null)">
                            <td>@evento.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@(evento.TipoEventoNombre ?? "—")</td>
                            <td>@ContextoTexto(evento.CampanaPotreroId)</td>
                            <td>@(evento.RegistradoPor ?? "—")</td>
                            <td>@evento.Fotografias.Count</td>
                            <td>@evento.Estado</td>
                            <td class="actions">
                                <button @onclick="() => VerEvento(evento.Id)">Ver</button>
                                @if (Auth.CanManage(SigaModule.Eventos) && evento.Estado == EstadoEvento.Registrado)
                                {
                                    <button @onclick="() => EditEvento(evento.Id)">Editar</button>
                                    <button class="destructive" @onclick="() => BeginAnular(evento.Id)">Anular</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (anularId is Guid anularEventoId)
        {
            <div class="inline-confirm">
                <p><strong>Anular evento</strong> — indicá el motivo. La información no se elimina.</p>
                <input @bind="anularMotivo" placeholder="Motivo de anulación" />
                <div class="form-actions">
                    <button class="destructive" @onclick="() => ConfirmAnular(anularEventoId)">Confirmar anulación</button>
                    <button @onclick="CancelAnular">Cancelar</button>
                </div>
            </div>
        }
    </section>

    @if (Auth.CanManage(SigaModule.Eventos))
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Registrar evento" : "Editar evento")" OnClose="Cancel">
            <EventoForm Model="editModel"
                        Campanas="campanas"
                        TiposEvento="tiposEvento"
                        OnValidSubmit="Save"
                        OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }

    @if (selectedEvento is not null)
    {
        <section class="card">
            <div class="card-header">
                <div>
                    <h2>@selectedEvento.Descripcion</h2>
                    <p class="muted">@selectedEvento.Fecha.ToString("dd/MM/yyyy") · @ContextoTexto(selectedEvento.CampanaPotreroId) · @selectedEvento.Estado</p>
                    @if (!string.IsNullOrWhiteSpace(selectedEvento.Ubicacion))
                    {
                        <p class="muted">Ubicación: @selectedEvento.Ubicacion</p>
                    }
                    @if (selectedEvento.Latitud is double latitud && selectedEvento.Longitud is double longitud)
                    {
                        <p class="muted">GPS: @latitud.ToString("0.######"), @longitud.ToString("0.######")</p>
                    }
                </div>
                <button @onclick="() => selectedEvento = null">Cerrar</button>
            </div>

            @if (selectedEvento.Fotografias.Count == 0)
            {
                <p class="muted">Este evento no tiene fotografías.</p>
            }
            else
            {
                <div class="photo-grid">
                    @foreach (var foto in selectedEvento.Fotografias)
                    {
                        <figure class="photo-card @(foto.Visible ? null : "photo-hidden")">
                            @if (foto.Visible && fotoUrls.GetValueOrDefault(foto.Id) is string url)
                            {
                                <img src="@url" alt="@foto.NombreArchivo" loading="lazy" />
                            }
                            else
                            {
                                <div class="photo-placeholder">Imagen oculta</div>
                            }
                            <figcaption>
                                <span>@foto.NombreArchivo</span>
                                <span class="muted">@SigaTime.Format(foto.FechaCaptura)</span>
                                @if (!foto.Visible)
                                {
                                    <span class="muted">Motivo: @foto.MotivoOcultamiento</span>
                                }
                                else if (CanHidePhoto)
                                {
                                    <button class="link-button destructive" @onclick="() => BeginOcultar(foto)">Ocultar</button>
                                }
                            </figcaption>
                        </figure>
                    }
                </div>
            }

            @if (ocultarId is Guid ocultarFotoId)
            {
                <div class="inline-confirm">
                    <p><strong>Ocultar fotografía</strong> — indicá el motivo. El archivo se conserva.</p>
                    <input @bind="ocultarMotivo" placeholder="Motivo de ocultamiento" />
                    <div class="form-actions">
                        <button class="destructive" @onclick="() => ConfirmOcultar(ocultarFotoId)">Confirmar</button>
                        <button @onclick="CancelOcultar">Cancelar</button>
                    </div>
                </div>
            }
        </section>
    }

    @if (Auth.CanManage(SigaModule.Eventos))
    {
        <details class="card bulk-card">
            <summary><strong>Registrar el mismo evento en varios potreros</strong></summary>
            <p class="field-help">Se crea un evento independiente por potrero, tal como exige el relevamiento en campo.</p>
            <div class="filter-row">
                <div class="form-field compact-field">
                    <label for="bulk-tipo">Tipo de evento</label>
                    <select id="bulk-tipo" @bind="bulkTipoEventoId">
                        <option value="@Guid.Empty">Seleccioná un tipo...</option>
                        @foreach (var tipo in tiposEvento)
                        {
                            <option value="@tipo.Id">@tipo.Nombre</option>
                        }
                    </select>
                </div>
                <div class="form-field compact-field">
                    <label for="bulk-fecha">Fecha</label>
                    <input id="bulk-fecha" type="date" @bind="bulkFecha" />
                </div>
                <div class="form-field compact-field">
                    <label for="bulk-ubicacion">Ubicación</label>
                    <input id="bulk-ubicacion" @bind="bulkUbicacion" placeholder="Opcional" />
                </div>
            </div>
            <div class="form-field">
                <label for="bulk-descripcion">Descripción</label>
                <textarea id="bulk-descripcion" @bind="bulkDescripcion" rows="2"></textarea>
            </div>
            <div class="form-field">
                <label>Campañas y potreros</label>
                <div class="checkbox-grid">
                    @foreach (var campana in campanas.Where(item => item.Estado is EstadoCampana.Planificada or EstadoCampana.Activa))
                    {
                        @foreach (var potrero in campana.Potreros)
                        {
                            <label class="checkbox-item">
                                <input type="checkbox"
                                       checked="@bulkSeleccion.Contains(potrero.Id)"
                                       @onchange="eventArgs => ToggleBulk(potrero.Id, eventArgs)" />
                                <span>@campana.Nombre · @potrero.PotreroNombre</span>
                            </label>
                        }
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(bulkError))
            {
                <p class="form-error" role="alert">@bulkError</p>
            }
            <div class="form-actions">
                <button class="primary-button" @onclick="SaveBulk">Registrar en los potreros seleccionados</button>
            </div>
        </details>
    }
</RoleGuard>

@code {
    private IReadOnlyList<EventoDto> eventos = [];
    private IReadOnlyList<TipoEventoDto> tiposEvento = [];
    private IReadOnlyList<CampanaDto> campanas = [];
    private EventoFormModel editModel = NewModel();
    private EventoDto? selectedEvento;
    private string? formError;
    private string? pageError;
    private bool formOpen;
    private bool cargando;
    private string search = string.Empty;
    private string filterTipo = string.Empty;
    private string filterEstado = string.Empty;

    private Guid? anularId;
    private string anularMotivo = string.Empty;

    private Guid? ocultarId;
    private long ocultarVersion;
    private string ocultarMotivo = string.Empty;
    private readonly Dictionary<Guid, string?> fotoUrls = [];

    private Guid bulkTipoEventoId = Guid.Empty;
    private DateTime bulkFecha = SigaTime.TodayLocal;
    private string bulkDescripcion = string.Empty;
    private string? bulkUbicacion;
    private string? bulkError;
    private readonly HashSet<Guid> bulkSeleccion = [];

    [Parameter] public Guid? editId { get; set; }

    private bool CanHidePhoto => Auth.CurrentUser is { Role: var role } && Permissions.CanHidePhoto(role);

    private IEnumerable<EventoDto> Filtered => eventos.Where(evento =>
        (string.IsNullOrWhiteSpace(search) ||
         (evento.Descripcion?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (evento.Ubicacion?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (evento.RegistradoPor?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrWhiteSpace(filterTipo) || evento.TipoEventoId.ToString() == filterTipo) &&
        (string.IsNullOrWhiteSpace(filterEstado) || evento.Estado.ToString() == filterEstado));

    protected override void OnInitialized()
    {
        Notificador.Cambio += HandleChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();

        if (editId is Guid id)
        {
            var evento = eventos.FirstOrDefault(candidato => candidato.Id == id);

            editModel = evento is null
                ? NewModel()
                : new EventoFormModel
                {
                    Id = evento.Id,
                    CampanaPotreroId = evento.CampanaPotreroId,
                    TipoEventoId = evento.TipoEventoId,
                    Fecha = evento.Fecha,
                    Descripcion = evento.Descripcion ?? string.Empty,
                    Ubicacion = evento.Ubicacion,
                    Latitud = evento.Latitud,
                    Longitud = evento.Longitud,
                    Version = evento.Version
                };

            formOpen = true;
            formError = null;
        }
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            eventos = await EventoService.GetAllAsync(incluirAnulados: true);
            tiposEvento = await TipoEventoService.GetAllAsync(incluirInactivos: true);
            campanas = await CampanaService.GetAllAsync(incluirAnuladas: false);

            if (selectedEvento is not null)
            {
                selectedEvento = eventos.FirstOrDefault(evento => evento.Id == selectedEvento.Id);
                await CargarUrlsFotosAsync(selectedEvento);
            }
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Eventos &&
            modulo != ModulosDatos.Fotos &&
            modulo != ModulosDatos.TiposEvento &&
            modulo != ModulosDatos.Campanas &&
            modulo != ModulosDatos.EmpresaActiva)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void NewEvento()
    {
        editModel = NewModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/eventos", replace: true);
    }

    private void EditEvento(Guid id) => Navigation.NavigateTo($"/eventos/{id}");

    private async Task VerEvento(Guid id)
    {
        selectedEvento = await EventoService.GetByIdAsync(id);
        ocultarId = null;
        await CargarUrlsFotosAsync(selectedEvento);
    }

    private async Task CargarUrlsFotosAsync(EventoDto? evento)
    {
        fotoUrls.Clear();

        if (evento is null)
        {
            return;
        }

        foreach (var foto in evento.Fotografias)
        {
            fotoUrls[foto.Id] = await FotografiaService.ObtenerDataUrlAsync(foto);
        }
    }

    private void Cancel()
    {
        formOpen = false;
        editModel = NewModel();
        formError = null;
        Navigation.NavigateTo("/eventos", replace: true);
    }

    private async Task Save(EventoFormModel model)
    {
        formError = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                var creado = await EventoService.CreateAsync(new CrearEventoDto
                {
                    EmpresaId = Contexto.EmpresaActivaId,
                    CampanaPotreroId = model.CampanaPotreroId,
                    TipoEventoId = model.TipoEventoId,
                    Fecha = model.Fecha.Date,
                    Descripcion = model.Descripcion.Trim(),
                    Ubicacion = model.Ubicacion?.Trim(),
                    Latitud = model.Latitud,
                    Longitud = model.Longitud
                });

                if (model.Fotos.Count > 0)
                {
                    await FotografiaService.SubirAsync(
                        creado.Id, model.Fotos, model.Latitud, model.Longitud);
                }
            }
            else
            {
                var actualizado = await EventoService.UpdateAsync(new ActualizarEventoDto
                {
                    Id = model.Id,
                    TipoEventoId = model.TipoEventoId,
                    Fecha = model.Fecha.Date,
                    Descripcion = model.Descripcion.Trim(),
                    Ubicacion = model.Ubicacion?.Trim(),
                    Latitud = model.Latitud,
                    Longitud = model.Longitud,
                    Version = model.Version
                });

                if (actualizado is null)
                {
                    throw new InvalidOperationException("No se encontró el evento.");
                }

                if (model.Fotos.Count > 0)
                {
                    await FotografiaService.SubirAsync(
                        actualizado.Id, model.Fotos, model.Latitud, model.Longitud);
                }
            }

            Cancel();
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void BeginAnular(Guid id)
    {
        anularId = id;
        anularMotivo = string.Empty;
        pageError = null;
    }

    private void CancelAnular()
    {
        anularId = null;
        anularMotivo = string.Empty;
    }

    private async Task ConfirmAnular(Guid id)
    {
        pageError = null;

        try
        {
            await EventoService.AnularAsync(id, anularMotivo);
            selectedEvento = null;
            CancelAnular();
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void BeginOcultar(FotografiaDto foto)
    {
        ocultarId = foto.Id;
        ocultarVersion = foto.Version;
        ocultarMotivo = string.Empty;
    }

    private void CancelOcultar()
    {
        ocultarId = null;
        ocultarMotivo = string.Empty;
    }

    private async Task ConfirmOcultar(Guid fotoId)
    {
        pageError = null;

        try
        {
            if (selectedEvento is null)
            {
                return;
            }

            await FotografiaService.OcultarAsync(
                selectedEvento.Id, fotoId, ocultarMotivo, ocultarVersion);

            selectedEvento = await EventoService.GetByIdAsync(selectedEvento.Id);
            await CargarUrlsFotosAsync(selectedEvento);

            CancelOcultar();
        }
        catch (InvalidOperationException exception)
        {
            pageError = exception.Message;
        }
    }

    private void ToggleBulk(Guid id, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            bulkSeleccion.Add(id);
        }
        else
        {
            bulkSeleccion.Remove(id);
        }
    }

    private async Task SaveBulk()
    {
        bulkError = null;

        try
        {
            if (bulkTipoEventoId == Guid.Empty)
            {
                throw new InvalidOperationException("Seleccioná un tipo de evento.");
            }

            if (bulkSeleccion.Count == 0)
            {
                throw new InvalidOperationException("Seleccioná al menos un potrero.");
            }

            await EventoService.CreateForPotrerosAsync(new CrearEventosLoteDto
            {
                EmpresaId = Contexto.EmpresaActivaId,
                CampanaPotreroIds = bulkSeleccion.ToList(),
                TipoEventoId = bulkTipoEventoId,
                Fecha = bulkFecha.Date,
                Descripcion = bulkDescripcion.Trim(),
                Ubicacion = bulkUbicacion?.Trim()
            });

            bulkSeleccion.Clear();
            bulkDescripcion = string.Empty;
            bulkUbicacion = null;
            bulkTipoEventoId = Guid.Empty;
            bulkFecha = SigaTime.TodayLocal;
        }
        catch (InvalidOperationException exception)
        {
            bulkError = exception.Message;
        }
    }

    private static EventoFormModel NewModel() => new() { Fecha = SigaTime.TodayLocal };

    private string ContextoTexto(Guid id)
    {
        foreach (var campana in campanas)
        {
            var potrero = campana.Potreros.FirstOrDefault(item => item.Id == id);
            if (potrero is not null)
            {
                return $"{campana.Nombre} · {potrero.PotreroNombre}";
            }
        }

        return "—";
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;
}
