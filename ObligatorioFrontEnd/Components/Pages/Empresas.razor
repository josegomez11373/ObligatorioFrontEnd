@page "/empresas"
@page "/empresas/{editId:guid}"
@implements IDisposable
@inject EmpresaService EmpresaService
@inject NavigationManager Navigation
@inject DemoAuthService Auth

<PageTitle>Empresas | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Empresas">
    <section class="page-header">
        <div>
            <p class="eyebrow">Administración</p>
            <h1>Empresas</h1>
            <p class="page-intro">Crear, editar y desactivar empresas. No se borra el historial.</p>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewEmpresa">Nueva empresa</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
            <h2>Empresas (@(empresas?.Count ?? 0))</h2>
            @if (empresas is null)
            {
                <p>Cargando...</p>
            }
            else if (!empresas.Any())
            {
                <p class="muted">No hay empresas registradas.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Nombre</th><th>Creada</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var empresa in empresas)
                        {
                            <tr class="@(empresa.Activo ? null : "row-muted")">
                                <td>@empresa.Nombre</td>
                                <td>@SigaTime.Format(empresa.CreatedAt)</td>
                                <td>@(empresa.Activo ? "Activa" : "Desactivada")</td>
                                <td class="actions">
                                    @if (CanManage)
                                    {
                                        <button type="button" @onclick="() => EditEmpresa(empresa.Id)">Editar</button>
                                        @if (empresa.Activo)
                                        {
                                            <button type="button" class="destructive" @onclick="() => Deactivate(empresa.Id)">Desactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Crear empresa" : "Editar empresa")" OnClose="Cancel">
            <EmpresaForm Model="editModel" OnValidSubmit="HandleFormSubmit" OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<Empresa>? empresas;
    private EmpresaEditModel editModel = new();
    private string? formError;
    private string? error;
    private bool formOpen;

    [Parameter]
    public Guid? editId { get; set; }

    private bool CanManage => Auth.CanManage(SigaModule.Empresas);

    protected override void OnInitialized()
    {
        EmpresaService.StateChanged += HandleChanged;
        Load();
    }

    protected override void OnParametersSet()
    {
        formOpen = editId is not null;
        if (editId is not null)
        {
            var empresa = EmpresaService.GetById(editId.Value);
            if (empresa is not null)
            {
                editModel = new EmpresaEditModel
                {
                    Id = empresa.Id,
                    Nombre = empresa.Nombre,
                    Activo = empresa.Activo,
                    Version = empresa.Version
                };
            }
            else
            {
                formError = "No se encontró la empresa solicitada.";
            }
        }
        else
        {
            editModel = new EmpresaEditModel();
            formError = null;
        }
    }

    private void Load()
    {
        empresas = EmpresaService.GetAll();
        InvokeAsync(StateHasChanged);
    }

    private void HandleChanged() => Load();

    private void NewEmpresa()
    {
        editModel = new EmpresaEditModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/empresas", replace: true);
    }

    private void EditEmpresa(Guid id) => Navigation.NavigateTo($"/empresas/{id}");

    private void Cancel()
    {
        formOpen = false;
        editModel = new EmpresaEditModel();
        formError = null;
        error = null;
        Navigation.NavigateTo("/empresas", replace: true);
    }

    private void HandleFormSubmit(EmpresaEditModel model)
    {
        formError = null;
        error = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                EmpresaService.Create(model.Nombre);
            }
            else if (!EmpresaService.Update(model.Id, model.Nombre, model.Activo, model.Version))
            {
                formError = "No se encontró la empresa.";
                return;
            }

            editModel = new EmpresaEditModel();
            formOpen = false;
            Navigation.NavigateTo("/empresas", replace: true);
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private void Deactivate(Guid id)
    {
        error = null;

        try
        {
            EmpresaService.Deactivate(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    public void Dispose() => EmpresaService.StateChanged -= HandleChanged;
}
