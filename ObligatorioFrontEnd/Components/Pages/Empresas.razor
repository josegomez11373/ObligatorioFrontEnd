@page "/empresas"
@page "/empresas/{editId:guid}"
@implements IDisposable
@inject IServicioEmpresas EmpresaService
@inject NotificadorDatos Notificador
@inject NavigationManager Navigation
@inject IAuthService Auth

@using ObligatorioFrontEnd.Api.Contratos

<PageTitle>Empresas | SIGA</PageTitle>

<RoleGuard Module="SigaModule.Empresas">
    <section class="page-header">
        <div>
            <p class="eyebrow">Administración</p>
            <h1>Empresas</h1>
            <p class="page-intro">Crear, editar y desactivar empresas. No se borra el historial.</p>
        </div>
        @if (CanManage)
        {
            <button class="primary-button primary-button--inline" type="button" @onclick="NewEmpresa">Nueva empresa</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <section class="card">
            <h2>Empresas (@(empresas?.Count ?? 0))</h2>
            @if (cargando && empresas is null)
            {
                <p>Cargando...</p>
            }
            else if (empresas is null || !empresas.Any())
            {
                <p class="muted">No hay empresas registradas.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Nombre</th><th>Creada</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var empresa in empresas)
                        {
                            <tr class="@(empresa.Activo ? null : "row-muted")">
                                <td>@empresa.Nombre</td>
                                <td>@SigaTime.Format(empresa.FechaCreacion)</td>
                                <td>@(empresa.Activo ? "Activa" : "Desactivada")</td>
                                <td class="actions">
                                    @if (CanManage)
                                    {
                                        <button type="button" @onclick="() => EditEmpresa(empresa.Id)">Editar</button>
                                        @if (empresa.Activo)
                                        {
                                            <button type="button" class="destructive" @onclick="() => Deactivate(empresa.Id)">Desactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
    </section>
    @if (CanManage)
    {
        <SidePanel IsOpen="formOpen" Title="@(editModel.Id == Guid.Empty ? "Crear empresa" : "Editar empresa")" OnClose="Cancel">
            <EmpresaForm Model="editModel" OnValidSubmit="HandleFormSubmit" OnCancel="Cancel" />
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <p class="form-error" role="alert">@formError</p>
            }
        </SidePanel>
    }
</RoleGuard>

@code {
    private IReadOnlyList<EmpresaDto>? empresas;
    private EmpresaEditModel editModel = new();
    private string? formError;
    private string? error;
    private bool formOpen;
    private bool cargando;
    private Guid? loadedEditId;

    [Parameter]
    public Guid? editId { get; set; }

    private bool CanManage => Auth.CanManage(SigaModule.Empresas);

    protected override async Task OnInitializedAsync()
    {
        Notificador.Cambio += HandleChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (editId is null)
        {
            // Se conserva el panel si es un alta en curso; al volver de una edición
            // (por ejemplo con el enlace del menú) el panel debe cerrarse.
            if (formOpen && editModel.Id == Guid.Empty)
            {
                return;
            }

            loadedEditId = null;
            formOpen = false;
            return;
        }

        if (loadedEditId == editId && formOpen)
        {
            return;
        }

        loadedEditId = editId;
        formOpen = true;
        formError = null;

        var empresa = await EmpresaService.GetByIdAsync(editId.Value);
        if (empresa is null)
        {
            editModel = new EmpresaEditModel();
            formError = "No se encontró la empresa solicitada.";
            return;
        }

        editModel = new EmpresaEditModel
        {
            Id = empresa.Id,
            Nombre = empresa.Nombre,
            Activo = empresa.Activo,
            Version = empresa.Version
        };
    }

    private async Task LoadAsync()
    {
        cargando = true;

        try
        {
            empresas = await EmpresaService.GetAllAsync(includeInactive: true);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void HandleChanged(string modulo)
    {
        if (modulo != ModulosDatos.Empresas)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void NewEmpresa()
    {
        editModel = new EmpresaEditModel();
        formError = null;
        formOpen = true;
        Navigation.NavigateTo("/empresas", replace: true);
    }

    private void EditEmpresa(Guid id) => Navigation.NavigateTo($"/empresas/{id}");

    private void Cancel()
    {
        formOpen = false;
        editModel = new EmpresaEditModel();
        formError = null;
        error = null;
        Navigation.NavigateTo("/empresas", replace: true);
    }

    private async Task HandleFormSubmit(EmpresaEditModel model)
    {
        formError = null;
        error = null;

        try
        {
            if (model.Id == Guid.Empty)
            {
                await EmpresaService.CreateAsync(model.Nombre);
            }
            else if (!await EmpresaService.UpdateAsync(model.Id, model.Nombre, model.Activo, model.Version))
            {
                formError = "No se encontró la empresa.";
                return;
            }

            editModel = new EmpresaEditModel();
            formOpen = false;
            Navigation.NavigateTo("/empresas", replace: true);
        }
        catch (InvalidOperationException exception)
        {
            formError = exception.Message;
        }
    }

    private async Task Deactivate(Guid id)
    {
        error = null;

        try
        {
            await EmpresaService.DeactivateAsync(id);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
    }

    public void Dispose() => Notificador.Cambio -= HandleChanged;
}
