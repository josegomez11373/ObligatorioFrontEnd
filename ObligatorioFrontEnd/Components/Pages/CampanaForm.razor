@using ObligatorioFrontEnd.Api.Contratos
@using ObligatorioFrontEnd.Models

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-field">
        <label for="empresa">Empresa</label>
        <InputSelect id="empresa" @bind-Value="Model.EmpresaId" disabled="true">
            <option value="@Guid.Empty">Seleccioná una empresa...</option>
            @foreach (var empresa in Empresas)
            {
                <option value="@empresa.Id">@empresa.Nombre</option>
            }
        </InputSelect>
        <p class="field-help">La campaña pertenece a la empresa activa.</p>
    </div>

    <div class="form-field">
        <label for="nombre">Nombre</label>
        <InputText id="nombre" @bind-Value="Model.Nombre" />
    </div>

    <div class="form-field">
        <label for="cultivo">Cultivo</label>
        <InputSelect id="cultivo" @bind-Value="Model.CultivoId">
            <option value="@Guid.Empty">Seleccioná un cultivo...</option>
            @foreach (var cultivo in CultivosDisponibles)
            {
                <option value="@cultivo.Id">@cultivo.Nombre</option>
            }
        </InputSelect>
    </div>

    <div class="date-grid">
        <div class="form-field">
            <label for="inicio">Inicio</label>
            <InputDate id="inicio" @bind-Value="Model.FechaInicio" />
        </div>
        <div class="form-field">
            <label for="fin">Fin</label>
            <InputDate id="fin" @bind-Value="Model.FechaFin" />
        </div>
    </div>

    <div class="form-field">
        <label for="estado">Estado</label>
        <InputSelect id="estado" @bind-Value="Model.Estado" disabled="@(!EsEdicion)">
            @foreach (var estado in Enum.GetValues<EstadoCampana>())
            {
                <option value="@estado">@estado.DisplayName()</option>
            }
        </InputSelect>
        @if (!EsEdicion)
        {
            <p class="field-help">Las campañas nuevas se crean como Planificada.</p>
        }
    </div>

    <fieldset class="plot-picker">
        <legend>Potreros</legend>
        @if (EsEdicion)
        {
            <p class="field-help">Los potreros no se pueden cambiar al editar una campaña.</p>
        }
        else
        {
            <p class="field-help">Seleccioná uno o más potreros de esta empresa.</p>
        }
        @if (!PotrerosDisponibles.Any())
        {
            <p class="muted">No hay potreros activos disponibles para esta empresa.</p>
        }
        else
        {
            @foreach (var potrero in PotrerosDisponibles)
            {
                <label class="plot-option" @key="potrero.Id">
                    <input type="checkbox"
                           checked="@Model.PotreroIds.Contains(potrero.Id)"
                           disabled="@EsEdicion"
                           @onchange="args => TogglePotrero(potrero.Id, args)" />
                    <span><strong>@potrero.Nombre</strong><small>@potrero.EstablecimientoNombre · @(potrero.SuperficieHa?.ToString("G") ?? "Sin superficie") ha</small></span>
                </label>
            }
        }
    </fieldset>

    <div class="form-actions">
        <button class="primary-button" type="submit">Guardar</button>
        <button type="button" @onclick="HandleCancel">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public CampanaEditModel Model { get; set; } = new();

    /// <summary>Empresas habilitadas: solo la empresa activa.</summary>
    [Parameter]
    public IReadOnlyList<EmpresaDto> Empresas { get; set; } = [];

    [Parameter]
    public IReadOnlyList<CultivoDto> Cultivos { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PotreroDto> Potreros { get; set; } = [];

    [Parameter]
    public bool EsEdicion { get; set; }

    [Parameter]
    public EventCallback<CampanaEditModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private IEnumerable<CultivoDto> CultivosDisponibles => Cultivos
        .Where(cultivo => (cultivo.Activo || cultivo.Id == Model.CultivoId) &&
                          (Model.EmpresaId == Guid.Empty || cultivo.EmpresaId == Model.EmpresaId));

    private IEnumerable<PotreroDto> PotrerosDisponibles => Potreros
        .Where(potrero => (potrero.Activo || Model.PotreroIds.Contains(potrero.Id)) &&
                          (Model.EmpresaId == Guid.Empty || potrero.EmpresaId == Model.EmpresaId));

    private void TogglePotrero(Guid potreroId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            if (!Model.PotreroIds.Contains(potreroId))
            {
                Model.PotreroIds.Add(potreroId);
            }
        }
        else
        {
            Model.PotreroIds.Remove(potreroId);
        }
    }

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync(Model);

    private Task HandleCancel() => OnCancel.InvokeAsync();
}
